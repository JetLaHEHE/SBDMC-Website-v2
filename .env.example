# OpenRouter API key for the AI chatbot
# Get your key at https://openrouter.ai/keys
# Set this as a Netlify environment variable named OPENROUTER_API_KEY
OPENROUTER_API_KEY=

# Contact form webhook URL (Google Sheets Apps Script endpoint)
# Create a Google Sheet, go to Extensions > Apps Script, deploy as web app
# Set this as a Netlify environment variable named CONTACT_WEBHOOK_URL
CONTACT_WEBHOOK_URL=
