---
import Layout from "../layouts/Layout.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import { getStaticPaths, getLangFromParams, type LangCode, t } from "../i18n";
import termsTranslations from "../data/translations/terms.json";

export { getStaticPaths };
const lang = (Astro.props.lang || getLangFromParams(Astro.params)) as LangCode;
const tx = t(termsTranslations, lang);
---

<Layout title={tx.title} description={tx.subtitle} lang={lang}>
  <section aria-label="Terms of service hero" class="bg-primary-500 py-24">
    <div class="mx-auto max-w-3xl px-4 text-center sm:px-6 lg:px-8" data-aos="fade-up">
      <div class="mb-4 inline-block border border-white/20 px-4 py-1.5 text-xs font-medium text-white/70">{tx.badge}</div>
      <h1 class="mb-4 text-5xl font-extrabold text-white md:text-6xl">{tx.title}</h1>
      <p class="text-lg text-white/70">{tx.subtitle}</p>
    </div>
  </section>

  <Breadcrumb pages={[{ label: tx.breadcrumb }]} lang={lang} />

  <section aria-label="Terms of service content" class="py-24">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <div class="prose prose-gray max-w-none space-y-6 text-gray-600 leading-relaxed">
        <p>{tx.lastUpdated}</p>

        <h2 class="text-xl font-bold text-primary-500">{tx.section1Title}</h2>
        <p>{tx.section1Text}</p>

        <h2 class="text-xl font-bold text-primary-500">{tx.section2Title}</h2>
        <p>{tx.section2Text}</p>

        <h2 class="text-xl font-bold text-primary-500">{tx.section3Title}</h2>
        <p>{tx.section3Text}</p>

        <h2 class="text-xl font-bold text-primary-500">{tx.section4Title}</h2>
        <p>{tx.section4Text}</p>

        <h2 class="text-xl font-bold text-primary-500">{tx.section5Title}</h2>
        <p>{tx.section5Text}</p>

        <h2 class="text-xl font-bold text-primary-500">{tx.section6Title}</h2>
        <p>{tx.section6Text}</p>

        <h2 class="text-xl font-bold text-primary-500">{tx.section7Title}</h2>
        <p>
          <strong>{tx.section7Office}</strong><br />
          {tx.section7Address}<br />
          {tx.section7Address2}<br />
          {tx.section7Email}<br />
          {tx.section7Phone}
        </p>
      </div>
    </div>
  </section>
</Layout>


