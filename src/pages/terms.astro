---
import Layout from "../layouts/Layout.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
---

<Layout title="Terms of Service" description="Terms of Service of Subic Bay Gateway Park (SBDMC, Inc.).">
  <section aria-label="Terms of service hero" class="bg-primary-500 py-24">
    <div class="mx-auto max-w-3xl px-4 text-center sm:px-6 lg:px-8" data-aos="fade-up">
      <div class="mb-4 inline-block border border-white/20 px-4 py-1.5 text-xs font-medium text-white/70">Legal</div>
      <h1 class="mb-4 text-5xl font-extrabold text-white md:text-6xl">Terms of Service</h1>
      <p class="text-lg text-white/70">Terms and conditions for using our website</p>
    </div>
  </section>

  <Breadcrumb pages={[{ label: "Terms of Service" }]} />

  <section aria-label="Terms of service content" class="py-24">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <div class="prose prose-gray max-w-none space-y-6 text-gray-600 leading-relaxed">
        <p>Last updated: June 2026</p>

