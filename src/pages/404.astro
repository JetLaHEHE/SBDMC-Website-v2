---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Page Not Found">
  <section class="flex min-h-[80vh] items-center justify-center bg-surface">
    <div class="mx-auto max-w-lg px-4 text-center">
      <div class="mb-6 text-8xl font-black text-primary-500">404</div>
      <h1 class="mb-4 text-3xl font-bold text-primary-500">Page Not Found</h1>
      <p class="mb-8 text-gray-500">The page you're looking for doesn't exist or has been moved.</p>
      <a href="/" class="btn-primary">Back to Home</a>
      <div class="mt-10">
        <p class="mb-4 text-sm font-medium text-gray-400">Suggested Pages</p>
        <div class="flex flex-wrap justify-center gap-3">
          <a href="/rfid" class="rounded-lg border border-gray-200 bg-white px-4 py-2 text-sm font-medium text-gray-600 transition-all hover:border-primary-500 hover:text-primary-500">RFID Access</a>
          <a href="/business-services" class="rounded-lg border border-gray-200 bg-white px-4 py-2 text-sm font-medium text-gray-600 transition-all hover:border-primary-500 hover:text-primary-500">Business Services</a>
          <a href="/faq" class="rounded-lg border border-gray-200 bg-white px-4 py-2 text-sm font-medium text-gray-600 transition-all hover:border-primary-500 hover:text-primary-500">FAQ</a>
          <a href="/forms" class="rounded-lg border border-gray-200 bg-white px-4 py-2 text-sm font-medium text-gray-600 transition-all hover:border-primary-500 hover:text-primary-500">Downloads</a>
          <a href="/contact" class="rounded-lg border border-gray-200 bg-white px-4 py-2 text-sm font-medium text-gray-600 transition-all hover:border-primary-500 hover:text-primary-500">Contact Us</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
