---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Page Not Found">
  <section class="flex min-h-[80vh] items-center justify-center bg-surface">
    <div class="mx-auto max-w-lg px-4 text-center">
      <div class="mb-6 text-8xl font-black text-primary-500">404</div>
      <h1 class="mb-4 text-3xl font-bold text-primary-500">Page Not Found</h1>
      <p class="mb-8 text-gray-500">The page you're looking for doesn't exist or has been moved.</p>
      <a href="/" class="btn-primary">Back to Home</a>
    </div>
  </section>
</Layout>
