---
import Layout from "../../layouts/Layout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import { getStaticPaths, getLangFromParams, getLangPrefix, type LangCode, t } from "../../i18n";
import forLeaseTranslations from "../../data/translations/for-lease.json";

export { getStaticPaths };
const lang = (Astro.props.lang || getLangFromParams(Astro.params)) as LangCode;
const langPrefix = getLangPrefix(lang);
const tx = t(forLeaseTranslations, lang);
---

<Layout title={tx.title} description="View available warehouse and office spaces for lease at Subic Bay Gateway Park in the Freeport Zone." lang={lang}>
  <section aria-label="For lease hero" class="bg-primary-500 py-24">
    <div class="mx-auto max-w-3xl px-4 text-center sm:px-6 lg:px-8" data-aos="fade-up">
      <div class="mb-4 inline-block border border-white/20 px-4 py-1.5 text-xs font-medium text-white/70">{tx.badge}</div>
      <h1 class="mb-4 text-5xl font-extrabold text-white md:text-6xl">{tx.title}</h1>
      <p class="text-lg text-white/70">{tx.subtitle}</p>
    </div>
  </section>

  <Breadcrumb pages={[{ label: tx.title }]} lang={lang} />

  <section aria-label="Available spaces" class="py-24">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <p class="mb-10 text-center text-lg text-gray-600" data-aos="fade-up">{tx.description}</p>
      <div class="grid gap-6 md:grid-cols-2">
        {tx.leaseTypes.map((lease, i) => (
          <div class="card overflow-hidden border-l-4 border-primary-500" data-aos="fade-up" data-aos-delay={i === 1 || i === 3 ? 100 : 0}>
            <div class="bg-primary-500 p-6">
              <div class="inline-block border border-white/30 px-3 py-1 text-xs font-semibold text-white">{tx.availableBadge}</div>
              <div class="mt-4 text-white">
                <div class="text-3xl font-bold">{lease.size}</div>
                <div class="text-sm text-white/70">{lease.sizeLabel}</div>
              </div>
            </div>
            <div class="p-6">
              <h3 class="mb-2 text-xl font-bold text-primary-500">{lease.title}</h3>
              <p class="mb-4 text-sm text-gray-500">{lease.description}</p>
              <ul class="mb-6 space-y-2 text-sm text-gray-500">
                {lease.features.map((feature) => (
                  <li class="flex items-center gap-2"><svg aria-hidden="true" class="h-4 w-4 text-primary-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> {feature}</li>
                ))}
              </ul>
              <a href={langPrefix + "/contact"} class="text-sm font-semibold text-primary-500 hover:text-primary-600">{tx.inquireNow} &rarr;</a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section aria-label="How to lease" class="bg-primary-500 py-20">
    <div class="mx-auto max-w-3xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mx-auto max-w-xl" data-aos="fade-up">
        <h2 class="mb-4 text-3xl font-bold text-white">{tx.howToLeaseTitle}</h2>
        <p class="mb-2 text-white/60">{tx.howToLeaseSubtitle}</p>
      </div>
      <div class="mt-10 grid gap-6 md:grid-cols-4" data-aos="fade-up" data-aos-delay="100">
        {tx.steps.map((step, i) => (
          <div class="text-center">
            <div class="mx-auto mb-3 flex h-14 w-14 items-center justify-center border border-white/30 text-2xl font-bold text-white">{i + 1}</div>
            <div class="font-semibold text-white">{step.title}</div>
            <div class="text-sm text-white/50">{step.text}</div>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>


