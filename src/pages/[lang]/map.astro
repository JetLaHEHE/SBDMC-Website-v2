---
import Layout from "../../layouts/Layout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import { getStaticPaths, getLangFromParams, type LangCode, t } from "../../i18n";
import mapTranslations from "../../data/translations/map.json";

export { getStaticPaths };
const lang = (Astro.props.lang || getLangFromParams(Astro.params)) as LangCode;
const tx = t(mapTranslations, lang);
---

<Layout title={tx.title} description={tx.subtitle} lang={lang}>
  <section aria-label="Location map hero" class="bg-primary-500 pt-28 pb-24">
    <div class="mx-auto max-w-3xl px-4 text-center sm:px-6 lg:px-8" data-aos="fade-up">
      <div class="mb-4 inline-block border border-white/20 px-4 py-1.5 text-xs font-medium text-white/70">{tx.badge}</div>
      <h1 class="mb-4 text-5xl font-extrabold text-white md:text-6xl">{tx.title}</h1>
      <p class="text-lg text-white/70">{tx.subtitle}</p>
    </div>
  </section>

  <Breadcrumb pages={[{ label: tx.breadcrumb }]} lang={lang} />

  <section aria-label="Map and directions" class="py-24">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <div class="mb-8" data-aos="fade-up">
        <div class="mb-6">
          <h2 class="text-2xl font-bold text-primary-500">{tx.ourLocation}</h2>
          <p class="mt-1 text-gray-500">{tx.address}</p>
        </div>
        <div class="relative aspect-[16/9] w-full overflow-hidden shadow-lg">
          <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3850.634297273158!2d120.27188931537355!3d14.830276289659852!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3396716f8c6c1e51%3A0x8c6b5c5b5c5b5c5b!2sSubic%20Bay%20Gateway%20Park!5e0!3m2!1sen!2sph!4v1" width="100%" height="100%" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade" title={tx.mapTitle} class="absolute inset-0"></iframe>
        </div>
      </div>

      <h2 class="mb-6 text-2xl font-bold text-primary-500" data-aos="fade-up">{tx.gettingHere}</h2>
      <div class="grid gap-6 md:grid-cols-2">
        <div class="card border-l-4 border-primary-500" data-aos="fade-up">
          <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-lg bg-primary-500 text-white">
            <svg aria-hidden="true" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
          </div>
          <h3 class="mb-1 font-bold text-primary-500">{tx.directions[0].title}</h3>
          <p class="text-sm text-gray-500">{tx.directions[0].description}</p>
        </div>
        <div class="card border-l-4 border-primary-500" data-aos="fade-up" data-aos-delay="100">
          <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-lg bg-primary-500 text-white">
            <svg aria-hidden="true" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" /></svg>
          </div>
          <h3 class="mb-1 font-bold text-primary-500">{tx.directions[1].title}</h3>
          <p class="text-sm text-gray-500">{tx.directions[1].description}</p>
        </div>
        <div class="card border-l-4 border-primary-500" data-aos="fade-up">
          <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-lg bg-primary-500 text-white">
            <svg aria-hidden="true" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
          </div>
          <h3 class="mb-1 font-bold text-primary-500">{tx.directions[2].title}</h3>
          <p class="text-sm text-gray-500">{tx.directions[2].description}</p>
        </div>
        <div class="card border-l-4 border-primary-500" data-aos="fade-up" data-aos-delay="100">
          <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-lg bg-primary-500 text-white">
            <svg aria-hidden="true" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" /></svg>
          </div>
          <h3 class="mb-1 font-bold text-primary-500">{tx.directions[3].title}</h3>
          <p class="text-sm text-gray-500">{tx.directions[3].description}</p>
        </div>
      </div>
    </div>
  </section>
</Layout>


