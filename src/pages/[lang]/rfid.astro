---
import Layout from "../../layouts/Layout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import { getStaticPaths, getLangFromParams, getLangPrefix, type LangCode, t } from "../../i18n";
import rfidTranslations from "../../data/translations/rfid.json";

export { getStaticPaths };
const lang = (Astro.props.lang || getLangFromParams(Astro.params)) as LangCode;
const langPrefix = getLangPrefix(lang);
const tx = t(rfidTranslations, lang);
---

<Layout title={tx.metaTitle} description={tx.metaDescription} lang={lang}>
  <section aria-label="RFID hero" class="bg-primary-500 py-24">
    <div class="mx-auto max-w-3xl px-4 text-center sm:px-6 lg:px-8" data-aos="fade-up">
      <div class="mb-4 inline-block border border-white/20 px-4 py-1.5 text-xs font-medium text-white/70">{tx.badge}</div>
      <h1 class="mb-4 text-5xl font-extrabold text-white md:text-6xl">{tx.title}</h1>
      <p class="text-lg text-white/70">{tx.subtitle}</p>
    </div>
  </section>

  <Breadcrumb pages={[{ label: tx.breadcrumb1, href: "/rfid" }, { label: tx.badge }]} lang={lang} />

  <section aria-label="RFID information" class="py-24">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="mb-8 text-2xl font-bold text-primary-500" data-aos="fade-up">{tx.sectionInfoTitle}</h2>
      <div class="space-y-4">
        {tx.faqItems.map((item, i) => (
          <div class="card border-l-4 border-primary-500" data-aos="fade-up" data-aos-delay={i * 50}>
            <button class="faq-toggle flex w-full items-center justify-between text-left">
              <span class="pr-4 font-semibold text-primary-500">{item.q}</span>
              <svg aria-hidden="true" class="faq-icon h-5 w-5 shrink-0 text-primary-500 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
            </button>
            <div class="faq-answer max-h-0 overflow-hidden transition-all duration-300">
              <div class="border-t border-gray-100 pt-4">
                {item.list ? (
                  <ul class="list-disc space-y-2 pl-5 text-gray-600">
                    {item.list.map((li) => <li>{li}</li>)}
                  </ul>
                ) : (
                  <p class="leading-relaxed text-gray-600">{item.a}</p>
                )}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section aria-label="RFID fees" class="bg-white py-16">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8" data-aos="fade-up">
      <div class="rounded-xl border border-gray-200 bg-white p-8 shadow-sm">
        <h2 class="mb-6 text-2xl font-bold text-primary-500">{tx.feesTitle}</h2>
        <div class="overflow-hidden rounded-lg border border-gray-200">
          <table class="w-full text-left">
            <thead class="bg-gray-50">
              <tr>
                <th class="px-6 py-4 text-sm font-semibold text-gray-600">{tx.feesCategoryHeader}</th>
                <th class="px-6 py-4 text-sm font-semibold text-gray-600">{tx.feesFeeHeader}</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200">
              {tx.feesRows.map((row) => (
                <tr>
                  <td class="px-6 py-4 text-gray-700">{row.category}</td>
                  <td class="px-6 py-4 font-semibold text-primary-500">{row.fee}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>

  <section aria-label="RFID gate locations" class="bg-gray-50 py-16">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8" data-aos="fade-up">
      <div class="rounded-xl border border-gray-200 bg-gray-50 p-8 shadow-sm">
        <h2 class="mb-4 text-2xl font-bold text-primary-500">{tx.gateLocationsTitle}</h2>
        <p class="leading-relaxed text-gray-600">{tx.gateLocationsText}</p>
      </div>
    </div>
  </section>

  <section aria-label="RFID requirements" class="bg-white py-16">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8" data-aos="fade-up">
      <div class="rounded-xl border border-gray-200 bg-white p-8 shadow-sm">
        <h2 class="mb-2 text-2xl font-bold text-primary-500">{tx.requirementsTitle}</h2>
        <p class="mb-6 text-sm font-semibold text-red-500">{tx.requirementsNotice}</p>
        <div class="overflow-hidden rounded-lg border border-gray-200">
          <table class="w-full text-left">
            <thead class="bg-gray-50">
              <tr>
                <th class="px-6 py-4 text-sm font-semibold text-gray-600">{tx.requirementsCategoryHeader}</th>
                <th class="px-6 py-4 text-sm font-semibold text-gray-600">{tx.requirementsReqHeader}</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200">
              {tx.requirementsRows.map((row) => (
                <tr>
                  <td class="px-6 py-4 text-gray-700">{row.category}</td>
                  <td class="px-6 py-4 text-gray-700">{row.req}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <div class="mt-6 space-y-3 rounded-lg bg-yellow-50 border border-yellow-200 p-4 text-sm text-gray-600">
          {tx.requirementsNotes.map((note) => (
            <p>{note}</p>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section aria-label="RFID usage guidelines" class="bg-gray-50 py-24">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <h2 class="mb-8 text-2xl font-bold text-primary-500" data-aos="fade-up">{tx.guidelinesTitle}</h2>
      <div class="grid gap-6 md:grid-cols-2">
        <div class="card border-l-4 border-yellow-500" data-aos="fade-up">
          <div class="mb-4 flex h-14 w-14 items-center justify-center rounded-lg bg-yellow-500 text-white">
            <svg aria-hidden="true" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
          </div>
          <h3 class="mb-2 font-bold text-yellow-600">{tx.guidelines[0].title}</h3>
          <p class="text-sm text-gray-500">{tx.guidelines[0].text}</p>
        </div>

        <div class="card border-l-4 border-blue-500" data-aos="fade-up" data-aos-delay="50">
          <div class="mb-4 flex h-14 w-14 items-center justify-center rounded-lg bg-blue-500 text-white">
            <svg aria-hidden="true" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
          </div>
          <h3 class="mb-2 font-bold text-blue-600">{tx.guidelines[1].title}</h3>
          <p class="text-sm text-gray-500">{tx.guidelines[1].text}</p>
        </div>

        <div class="card border-l-4 border-red-500" data-aos="fade-up">
          <div class="mb-4 flex h-14 w-14 items-center justify-center rounded-lg bg-red-500 text-white">
            <svg aria-hidden="true" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" /></svg>
          </div>
          <h3 class="mb-2 font-bold text-red-600">{tx.guidelines[2].title}</h3>
          <p class="text-sm text-gray-500">{tx.guidelines[2].text}</p>
        </div>

        <div class="card border-l-4 border-purple-500" data-aos="fade-up" data-aos-delay="50">
          <div class="mb-4 flex h-14 w-14 items-center justify-center rounded-lg bg-purple-500 text-white">
            <svg aria-hidden="true" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
          </div>
          <h3 class="mb-2 font-bold text-purple-600">{tx.guidelines[3].title}</h3>
          <p class="text-sm text-gray-500">{tx.guidelines[3].text}</p>
        </div>
      </div>
    </div>
  </section>

  <section aria-label="RFID dos and don'ts" class="bg-white py-16">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8" data-aos="fade-up">
      <div class="rounded-xl border border-gray-200 bg-gray-50 p-8 shadow-sm">
        <h2 class="mb-6 text-2xl font-bold text-primary-500">{tx.dosDontsTitle}</h2>
        <div class="grid gap-8 md:grid-cols-2">
          <div>
            <h3 class="mb-3 flex items-center gap-2 text-lg font-bold text-green-600">
              <svg aria-hidden="true" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
              {tx.dosTitle}
            </h3>
            <ul class="space-y-2 text-sm text-gray-600">
              {tx.dosItems.map((item) => (
                <li class="flex items-start gap-2">
                  <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-green-500"></span>
                  {item}
                </li>
              ))}
            </ul>
          </div>
          <div>
            <h3 class="mb-3 flex items-center gap-2 text-lg font-bold text-red-600">
              <svg aria-hidden="true" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
              {tx.dontsTitle}
            </h3>
            <ul class="space-y-2 text-sm text-gray-600">
              {tx.dontsItems.map((item) => (
                <li class="flex items-start gap-2">
                  <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-red-500"></span>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section aria-label="RFID damage penalties" class="py-16">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8" data-aos="fade-up">
      <div class="rounded-xl border-2 border-red-300 bg-red-50 p-6 text-center">
        <div class="mb-3 flex justify-center">
          <svg class="h-10 w-10 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z" /></svg>
        </div>
        <h3 class="mb-2 text-xl font-bold text-red-700">{tx.damageTitle}</h3>
        <p class="text-lg font-semibold text-red-600">{tx.damagePenalty}</p>
      </div>
    </div>
  </section>

  <section aria-label="RFID downloads" class="bg-gray-50 py-24">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <h2 class="mb-8 text-2xl font-bold text-primary-500" data-aos="fade-up">{tx.downloadsTitle}</h2>
      <div class="grid gap-6 md:grid-cols-2">
        {tx.downloads.map((item, i) => (
          <div class="card border-l-4 border-primary-500" data-aos="fade-up" data-aos-delay={i * 100}>
            <div class="mb-5 flex h-14 w-14 items-center justify-center rounded-lg bg-primary-500 text-white">
              <svg aria-hidden="true" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
            </div>
            <h3 class="mb-2 text-lg font-bold text-primary-500">{item.title}</h3>
            <p class="mb-4 text-sm text-gray-500">{item.text}</p>
            <a href={i === 0 ? "https://irp.cdn-website.com/33a8ffc6/files/uploaded/RFID_FORM_20220903.pdf" : "https://irp.cdn-website.com/33a8ffc6/files/uploaded/SOP+for+RFID.pdf"} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-sm font-semibold text-primary-500 transition-all hover:text-primary-600">
              <svg aria-hidden="true" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
              {item.linkText}
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section aria-label="RFID contact information" class="bg-gray-50 py-16">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8" data-aos="fade-up">
      <div class="rounded-xl border border-gray-200 bg-gray-50 p-8 shadow-sm">
        <h2 class="mb-4 text-2xl font-bold text-primary-500">{tx.contactTitle}</h2>
        <p class="leading-relaxed text-gray-600">{tx.contactText}</p>
      </div>
    </div>
  </section>

  <section aria-label="RFID related links" class="bg-white py-16">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 text-center" data-aos="fade-up">
      <h2 class="mb-6 text-2xl font-bold text-primary-500">{tx.relatedLinksTitle}</h2>
      <div class="flex flex-wrap justify-center gap-4">
        <a href={langPrefix + "/business-services"} class="inline-flex items-center gap-2 rounded-lg border border-primary-500 px-6 py-3 text-sm font-semibold text-primary-500 transition-all hover:bg-primary-500 hover:text-white">
          <svg aria-hidden="true" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.935 23.935 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
          {tx.relatedLinkBusiness}
        </a>
        <a href={langPrefix + "/contact"} class="inline-flex items-center gap-2 rounded-lg border border-primary-500 px-6 py-3 text-sm font-semibold text-primary-500 transition-all hover:bg-primary-500 hover:text-white">
          <svg aria-hidden="true" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
          {tx.relatedLinkContact}
        </a>
        <a href={langPrefix + "/faq"} class="inline-flex items-center gap-2 rounded-lg border border-primary-500 px-6 py-3 text-sm font-semibold text-primary-500 transition-all hover:bg-primary-500 hover:text-white">
          <svg aria-hidden="true" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" /></svg>
          {tx.relatedLinkFaq}
        </a>
      </div>
    </div>
  </section>
</Layout>

<script>
  document.querySelectorAll(".faq-toggle").forEach((btn) => {
    btn.addEventListener("click", () => {
      const answer = btn.nextElementSibling;
      const icon = btn.querySelector(".faq-icon");
      const isOpen = answer.classList.contains("max-h-96");
      document.querySelectorAll(".faq-answer").forEach((el) => {
        el.classList.remove("max-h-96");
        el.classList.add("max-h-0");
        el.previousElementSibling.querySelector(".faq-icon")?.classList.remove("rotate-45");
      });
      if (!isOpen) {
        answer.classList.remove("max-h-0");
        answer.classList.add("max-h-96");
        icon?.classList.add("rotate-45");
      }
    });
  });
</script>


