---
import Layout from "../../layouts/Layout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import { getStaticPaths, getLangFromParams, type LangCode, t } from "../../i18n";
import privacyTranslations from "../../data/translations/privacy.json";

export { getStaticPaths };
const lang = (Astro.props.lang || getLangFromParams(Astro.params)) as LangCode;
const tx = t(privacyTranslations, lang);
---

<Layout title={tx.title} description="Privacy Policy of Subic Bay Gateway Park (SBDMC, Inc.)." lang={lang}>
  <section aria-label="Privacy policy hero" class="bg-primary-500 py-24">
    <div class="mx-auto max-w-3xl px-4 text-center sm:px-6 lg:px-8" data-aos="fade-up">
      <div class="mb-4 inline-block border border-white/20 px-4 py-1.5 text-xs font-medium text-white/70">{tx.badge}</div>
      <h1 class="mb-4 text-5xl font-extrabold text-white md:text-6xl">{tx.title}</h1>
      <p class="text-lg text-white/70">{tx.subtitle}</p>
    </div>
  </section>

  <Breadcrumb pages={[{ label: tx.title }]} lang={lang} />

  <section aria-label="Privacy policy content" class="py-24">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <div class="prose prose-gray max-w-none space-y-6 text-gray-600 leading-relaxed">
        <p>{tx.lastUpdated}</p>

        <h2 class="text-xl font-bold text-primary-500">{tx.sections[0].heading}</h2>
        <p>{tx.sections[0].paragraphs[0]}</p>
        <p>{tx.sections[0].paragraphs[1]}</p>

        <h2 class="text-xl font-bold text-primary-500">{tx.sections[1].heading}</h2>
        <p>{tx.sections[1].paragraphs[0]}</p>
        <ul class="list-disc pl-6 space-y-1">
          <li>{tx.sections[1].list[0]}</li>
          <li>{tx.sections[1].list[1]}</li>
          <li>{tx.sections[1].list[2]}</li>
          <li>{tx.sections[1].list[3]}</li>
        </ul>

        <h2 class="text-xl font-bold text-primary-500">{tx.sections[2].heading}</h2>
        <p>{tx.sections[2].paragraphs[0]}</p>

        <h2 class="text-xl font-bold text-primary-500">{tx.sections[3].heading}</h2>
        <p>{tx.sections[3].paragraphs[0]}</p>

        <h2 class="text-xl font-bold text-primary-500">{tx.sections[4].heading}</h2>
        <p>{tx.sections[4].paragraphs[0]}</p>

        <h2 class="text-xl font-bold text-primary-500">{tx.sections[5].heading}</h2>
        <p>{tx.sections[5].paragraphs[0]}</p>
        <p>
          <strong>{tx.sections[5].contact.name}</strong><br />
          {tx.sections[5].contact.address}<br />
          {tx.sections[5].contact.address2}<br />
          {tx.sections[5].contact.email}<br />
          {tx.sections[5].contact.phone}
        </p>
      </div>
    </div>
  </section>
</Layout>


