---
import Layout from "../../../layouts/Layout.astro";
import { getCollection, getEntry, render } from "astro:content";
import { getLangFromParams, getLangPrefix, type LangCode } from "../../../i18n";

export interface Props {
  lang?: LangCode;
  currentPath?: string;
}

export async function getStaticPaths() {
  const posts = await getCollection("news");
  const langs = ["en", "zh", "tl", "ja", "ko"];
  return posts.flatMap((post) => {
    const slug = post.id.replace(/\.\w+$/, "");
    return langs.map((lang) => ({
      params: { lang, slug },
      props: { lang: lang as LangCode, postId: post.id },
    }));
  });
}

const { postId } = Astro.props as { postId: string };
const lang = (Astro.props.lang || getLangFromParams(Astro.params)) as LangCode;
const langPrefix = getLangPrefix(lang);

const post = await getEntry("news", postId);

if (!post) {
  return Astro.redirect("/" + (lang === "en" ? "" : lang) + "/404");
}

const { Content } = await render(post);

const tag = (post.data.tags && post.data.tags.length > 0) ? post.data.tags[0] : "";
const tagMeta: Record<string, { icon: string; bg: string }> = {
  announcement: { icon: "📢", bg: "from-red-700 to-red-900" },
  guide: { icon: "📖", bg: "from-primary-600 to-primary-900" },
  "case study": { icon: "📊", bg: "from-green-700 to-green-900" },
  event: { icon: "📅", bg: "from-purple-700 to-purple-900" },
};
const meta = tagMeta[tag.toLowerCase()] || { icon: "📰", bg: "from-gray-600 to-gray-900" };

function formatDate(date: Date, lang: string): string {
  try {
    const locale = lang === "en" ? "en-US" : lang === "zh" ? "zh-TW" : lang === "tl" ? "tl-PH" : lang === "ja" ? "ja-JP" : "ko-KR";
    return date.toLocaleDateString(locale, { year: "numeric", month: "long", day: "numeric" });
  } catch {
    return date.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
  }
}

function tagLabel(tag: string): { icon: string; color: string; border: string } {
  const map: Record<string, { icon: string; color: string; border: string }> = {
    announcement: { icon: "📢", color: "bg-red-50 text-red-700 ring-red-300", border: "border-l-red-400" },
    guide: { icon: "📖", color: "bg-blue-50 text-blue-700 ring-blue-300", border: "border-l-blue-400" },
    "case study": { icon: "📊", color: "bg-green-50 text-green-700 ring-green-300", border: "border-l-green-400" },
    event: { icon: "📅", color: "bg-purple-50 text-purple-700 ring-purple-300", border: "border-l-purple-400" },
  };
  return map[tag.toLowerCase()] || { icon: "📰", color: "bg-gray-50 text-gray-700 ring-gray-300", border: "border-l-gray-400" };
}

function readingTime(body: string): number {
  const words = body.trim().split(/\s+/).length;
  return Math.max(1, Math.ceil(words / 200));
}

const minRead = readingTime(post.body);

const allPosts = await getCollection("news");
allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const relatedPosts = allPosts.filter((p) => p.id !== post.id).slice(0, 3);

const canonicalUrl = "https://sbdmc.com" + langPrefix + "/news/" + postId.replace(/\.\w+$/, "") + "/";
const shareTitle = encodeURIComponent(post.data.title + " — SBDMC, Inc.");
const shareUrl = encodeURIComponent(canonicalUrl);
const shareText = encodeURIComponent(post.data.excerpt);
---

<Layout title={post.data.title + " — SBDMC, Inc."} description={post.data.excerpt} lang={lang} currentPath={langPrefix + "/news/" + postId.replace(/\.\w+$/, "")}>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Article",
    headline: post.data.title,
    description: post.data.excerpt,
    datePublished: post.data.date.toISOString(),
    dateModified: post.data.date.toISOString(),
    author: { "@type": "Organization", name: "SBDMC, Inc." },
    publisher: { "@type": "Organization", name: "SBDMC, Inc.", logo: { "@type": "ImageObject", url: "https://sbdmc.com/images/logo.png" } },
    mainEntityOfPage: { "@type": "WebPage", "@id": canonicalUrl },
  })} />
  <main class="min-h-screen">
    <div class={"bg-gradient-to-br " + meta.bg + " pb-16 pt-28 text-white"}>
      <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
        <nav class="mb-8 text-sm text-white/70">
          <a href={langPrefix + "/news"} class="text-white/80 hover:text-white transition-colors">&larr; {lang === "en" ? "Back to News" : lang === "zh" ? "返回新聞" : lang === "tl" ? "Bumalik sa Balita" : lang === "ja" ? "ニュースに戻る" : "뉴스로 돌아가기"}</a>
        </nav>
        <div class="mb-4 flex flex-wrap items-center gap-3 text-sm text-white/70">
          <time datetime={post.data.date.toISOString()}>
            {formatDate(post.data.date, lang)}
          </time>
          <span class="text-white/50">&middot;</span>
          <span>{minRead} {lang === "en" ? "min read" : lang === "zh" ? "分钟阅读" : lang === "tl" ? "minuto" : lang === "ja" ? "分" : "분"}</span>
          {tag && (
            <span class="inline-flex items-center gap-1 rounded-full bg-white/20 px-3 py-1 text-xs font-medium text-white backdrop-blur-sm">
              {meta.icon} {tag.charAt(0).toUpperCase() + tag.slice(1)}
            </span>
          )}
        </div>
        <h1 class="text-4xl font-bold leading-tight sm:text-4xl">{post.data.title}</h1>
      </div>
    </div>
    <div class="mx-auto max-w-3xl px-4 pb-24 sm:px-6 lg:px-8">
      <article class="-mt-8 rounded-xl bg-white p-8 shadow-lg sm:p-10">
        <div class="prose prose-gray max-w-none">
          <Content />
        </div>
      </article>

      <div class="mt-8 flex items-center justify-between rounded-lg bg-gray-50 px-6 py-4">
        <span class="text-sm font-medium text-gray-500">{lang === "en" ? "Share this article:" : lang === "zh" ? "分享此文章：" : lang === "tl" ? "I-share ang artikulong ito:" : lang === "ja" ? "この記事をシェア：" : "이 기사 공유하기:"}</span>
        <div class="flex items-center gap-2">
          <a href={"https://www.facebook.com/sharer/sharer.php?u=" + shareUrl} target="_blank" rel="noopener noreferrer" class="flex h-9 w-9 items-center justify-center rounded-full bg-[#1877F2] text-white transition-all hover:scale-110" aria-label="Share on Facebook">
            <svg aria-hidden="true" class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          </a>
          <a href={"https://twitter.com/intent/tweet?text=" + shareTitle + "&url=" + shareUrl} target="_blank" rel="noopener noreferrer" class="flex h-9 w-9 items-center justify-center rounded-full bg-black text-white transition-all hover:scale-110" aria-label="Share on X">
            <svg aria-hidden="true" class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </a>
          <a href={"https://www.linkedin.com/sharing/share-offsite/?url=" + shareUrl} target="_blank" rel="noopener noreferrer" class="flex h-9 w-9 items-center justify-center rounded-full bg-[#0A66C2] text-white transition-all hover:scale-110" aria-label="Share on LinkedIn">
            <svg aria-hidden="true" class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          </a>
          <button data-copy-url={canonicalUrl} class="copy-link-btn flex h-9 w-9 items-center justify-center rounded-full bg-gray-200 text-gray-500 transition-all hover:bg-gray-300 hover:scale-110" aria-label="Copy link">
            <svg aria-hidden="true" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" /></svg>
          </button>
        </div>
      </div>

      {relatedPosts.length > 0 && (
        <section class="mt-12">
          <h2 class="mb-6 text-2xl font-bold text-primary-500">{lang === "en" ? "Related Articles" : lang === "zh" ? "相關文章" : lang === "tl" ? "Kaugnay na Artikulo" : lang === "ja" ? "関連記事" : "관련 기사"}</h2>
          <div class="grid gap-6 sm:grid-cols-3">
            {relatedPosts.map((rp) => {
              const rpTag = (rp.data.tags && rp.data.tags.length > 0) ? rp.data.tags[0] : "";
              const rpMeta = rpTag ? (tagLabel(rpTag) || { icon: "📰", color: "bg-gray-50 text-gray-700 ring-gray-300", border: "border-l-gray-400" }) : { icon: "📰", color: "bg-gray-50 text-gray-700 ring-gray-300", border: "border-l-gray-400" };
              return (
              <a href={langPrefix + "/news/" + rp.id.replace(/\.\w+$/, "")} class={"card block border-l-4 transition-all hover:shadow-md hover:-translate-y-0.5 " + (rpMeta.border || "border-l-gray-400")}>
                <div class="mb-2 text-2xl">{rpMeta.icon}</div>
                <h3 class="text-sm font-bold leading-snug text-primary-500">{rp.data.title}</h3>
                <p class="mt-1 text-xs text-gray-400">{rp.data.date.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" })}</p>
              </a>
              );
            })}
          </div>
        </section>
      )}
    </div>
  </main>
</Layout>

<script>
  document.querySelectorAll(".copy-link-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      const url = btn.getAttribute("data-copy-url");
      navigator.clipboard.writeText(url).then(() => {
        const html = btn.innerHTML;
        btn.textContent = "✓";
        setTimeout(() => { btn.innerHTML = html; }, 2000);
      });
    });
  });
</script>

