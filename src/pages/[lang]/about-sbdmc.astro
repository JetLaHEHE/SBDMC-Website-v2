---
import Layout from "../../layouts/Layout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import data from "../../data/about-sbdmc.json";
import { getStaticPaths, getLangFromParams, type LangCode, t } from "../../i18n";
import aboutTranslations from "../../data/translations/about-sbdmc.json";

export { getStaticPaths };
const lang = (Astro.props.lang || getLangFromParams(Astro.params)) as LangCode;
const tx = t(aboutTranslations, lang);
---

<Layout title={tx.metaTitle} description={tx.metaDescription} lang={lang}>
  <section aria-label="About SBDMC hero" class="bg-primary-500 pt-28 pb-24">
    <div class="mx-auto max-w-3xl px-4 text-center sm:px-6 lg:px-8">
      <div data-aos="fade-up">
        <div class="mb-4 inline-block border border-white/20 px-4 py-1.5 text-xs font-medium text-white/70">{tx.badge}</div>
        <h1 class="mb-4 text-5xl font-extrabold text-white md:text-6xl">{tx.title}</h1>
        <p class="text-lg text-white/70">{tx.subtitle}</p>
      </div>
    </div>
  </section>

  <Breadcrumb pages={[{ label: tx.breadcrumb1, href: "/about-sbdmc" }, { label: tx.breadcrumb2 }]} lang={lang} />

  <section aria-label="Introduction" class="bg-surface py-24">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-3xl text-center" data-aos="fade-up">
        <p class="text-lg leading-relaxed text-gray-600">{tx.intro}</p>
      </div>
    </div>
  </section>

  <section aria-label="History" class="bg-surface border-t border-gray-100 py-16">
    <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
      <blockquote class="text-xl font-light italic text-gray-600" data-aos="fade-up">
        &ldquo;{tx.historyQuote}&rdquo;
      </blockquote>
    </div>
  </section>

  <section aria-label="Mission and vision" class="py-24">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-8 md:grid-cols-2">
        <div class="card border-l-4 border-primary-500" data-aos="fade-up">
          <div class="mb-4 flex h-14 w-14 items-center justify-center rounded-lg bg-primary-500 text-white">
            <svg aria-hidden="true" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
          </div>
          <h3 class="mb-3 text-2xl font-bold text-primary-500">{tx.mission.title}</h3>
          <p class="leading-relaxed text-gray-600">{tx.mission.description}</p>
        </div>
        <div class="card border-l-4 border-primary-500" data-aos="fade-up" data-aos-delay="100">
          <div class="mb-4 flex h-14 w-14 items-center justify-center rounded-lg bg-primary-500 text-white">
            <svg aria-hidden="true" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>
          </div>
          <h3 class="mb-3 text-2xl font-bold text-primary-500">{tx.vision.title}</h3>
          <p class="leading-relaxed text-gray-600">{tx.vision.description}</p>
        </div>
      </div>
    </div>
  </section>

</Layout>


