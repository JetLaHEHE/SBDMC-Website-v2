---
import Layout from "../../layouts/Layout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import { getStaticPaths, getLangFromParams, getLangPrefix, t, type LangCode } from "../../i18n";
import descriptionTranslations from "../../data/translations/description.json";

export { getStaticPaths };
const lang = (Astro.props.lang || getLangFromParams(Astro.params)) as LangCode;
const langPrefix = getLangPrefix(lang);
const dx = t(descriptionTranslations, lang);
---

<Layout title={dx.metaTitle} description={dx.metaDescription} lang={lang}>
  <section aria-label="SBGP hero" class="bg-primary-500 pt-28 pb-24">
    <div class="mx-auto max-w-3xl px-4 text-center sm:px-6 lg:px-8" data-aos="fade-up">
      <div class="mb-4 inline-block border border-white/20 px-4 py-1.5 text-xs font-medium text-white/70">{dx.badge}</div>
      <h1 class="mb-4 text-5xl font-extrabold text-white md:text-6xl">{dx.title}</h1>
      <p class="text-lg text-white/70">{dx.subtitle}</p>
    </div>
  </section>

  <Breadcrumb pages={[{ label: dx.breadcrumbAbout, href: "/about-sbdmc" }, { label: dx.breadcrumbSbgp }]} lang={lang} />

  <section aria-label="Park description" class="bg-surface py-24">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <h2 class="mb-6 text-3xl font-bold text-primary-500" data-aos="fade-up">{dx.descriptionTitle}</h2>
      <p class="mb-6 leading-relaxed text-gray-600" data-aos="fade-up" data-aos-delay="100">
        {dx.descriptionPara1a}<strong class="text-gray-900">{dx.descriptionPara1b}</strong>{dx.descriptionPara1c}
      </p>
      <p class="leading-relaxed text-gray-600" data-aos="fade-up" data-aos-delay="150">
        {dx.descriptionPara2}
      </p>
    </div>
  </section>

  <section aria-label="Infrastructure" class="py-24">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <h2 class="mb-12 text-center text-3xl font-bold text-primary-500" data-aos="fade-up">{dx.infraTitle}</h2>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        <div class="card border-l-4 border-primary-500" data-aos="fade-up">
          <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-lg bg-primary-500 text-white"><svg aria-hidden="true" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg></div>
          <h3 class="mb-1 font-bold text-primary-500">{dx.infraPowerTitle}</h3>
          <p class="text-sm text-gray-500">{dx.infraPowerDesc}</p>
        </div>
        <div class="card border-l-4 border-primary-500" data-aos="fade-up" data-aos-delay="100">
          <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-lg bg-primary-500 text-white"><svg aria-hidden="true" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" /></svg></div>
          <h3 class="mb-1 font-bold text-primary-500">{dx.infraWaterTitle}</h3>
          <p class="text-sm text-gray-500">{dx.infraWaterDesc}</p>
        </div>
        <div class="card border-l-4 border-primary-500" data-aos="fade-up" data-aos-delay="200">
          <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-lg bg-primary-500 text-white"><svg aria-hidden="true" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.111 16.404a5.5 5.5 0 017.778 0M12 20h.01m-7.08-7.071c3.904-3.905 10.236-3.905 14.141 0M1.394 9.393c5.857-5.858 15.355-5.858 21.213 0" /></svg></div>
          <h3 class="mb-1 font-bold text-primary-500">{dx.infraTelecomTitle}</h3>
          <p class="text-sm text-gray-500">{dx.infraTelecomDesc}</p>
        </div>
        <div class="card border-l-4 border-primary-500" data-aos="fade-up">
          <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-lg bg-primary-500 text-white"><svg aria-hidden="true" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" /></svg></div>
          <h3 class="mb-1 font-bold text-primary-500">{dx.infraRoadsTitle}</h3>
          <p class="text-sm text-gray-500">{dx.infraRoadsDesc}</p>
        </div>
        <div class="card border-l-4 border-primary-500" data-aos="fade-up" data-aos-delay="100">
          <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-lg bg-primary-500 text-white"><svg aria-hidden="true" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" /></svg></div>
          <h3 class="mb-1 font-bold text-primary-500">{dx.infraSecurityTitle}</h3>
          <p class="text-sm text-gray-500">{dx.infraSecurityDesc}</p>
        </div>
        <div class="card border-l-4 border-primary-500" data-aos="fade-up" data-aos-delay="200">
          <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-lg bg-primary-500 text-white"><svg aria-hidden="true" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg></div>
          <h3 class="mb-1 font-bold text-primary-500">{dx.infraWasteTitle}</h3>
          <p class="text-sm text-gray-500">{dx.infraWasteDesc}</p>
        </div>
      </div>
    </div>
  </section>

  <section aria-label="Master plan" class="bg-surface py-24">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <h2 class="mb-6 text-3xl font-bold text-primary-500" data-aos="fade-up">{dx.masterPlanTitle}</h2>
      <p class="mb-8 leading-relaxed text-gray-600" data-aos="fade-up" data-aos-delay="100">
        {dx.masterPlanDesc}
      </p>
      <div class="grid gap-4 md:grid-cols-3" data-aos="fade-up" data-aos-delay="200">
        <div class="border border-gray-200 bg-white p-5 text-center">
          <div class="text-2xl font-bold text-primary-500">{dx.masterPlanIndustrial}</div>
          <div class="text-sm text-gray-500">{dx.masterPlanIndustrialSub}</div>
        </div>
        <div class="border border-gray-200 bg-white p-5 text-center">
          <div class="text-2xl font-bold text-primary-500">{dx.masterPlanCommercial}</div>
          <div class="text-sm text-gray-500">{dx.masterPlanCommercialSub}</div>
        </div>
        <div class="border border-gray-200 bg-white p-5 text-center">
          <div class="text-2xl font-bold text-primary-500">{dx.masterPlanGreen}</div>
          <div class="text-sm text-gray-500">{dx.masterPlanGreenSub}</div>
        </div>
      </div>
    </div>
  </section>

  <section aria-label="Accessibility" class="py-24">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <h2 class="mb-6 text-3xl font-bold text-primary-500" data-aos="fade-up">{dx.accessibilityTitle}</h2>
      <p class="mb-10 leading-relaxed text-gray-600" data-aos="fade-up" data-aos-delay="100">
        {dx.accessibilityDesc}
      </p>
      <div class="bg-primary-500 p-8 text-white text-center" data-aos="fade-up">
        <h3 class="mb-3 text-xl font-bold">{dx.videoTitle}</h3>
        <p class="mb-4 text-white/80">{dx.videoDesc}</p>
        <a href={langPrefix + "/contact"} class="btn-white">{dx.videoCta}</a>
      </div>
    </div>
  </section>
</Layout>

