---
import Layout from "../../layouts/Layout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import data from "../../data/business-incentives.json";
import { getStaticPaths, getLangFromParams, getLangPrefix, type LangCode, t } from "../../i18n";
import incentivesTranslations from "../../data/translations/business-incentives.json";

export { getStaticPaths };
const lang = (Astro.props.lang || getLangFromParams(Astro.params)) as LangCode;
const langPrefix = getLangPrefix(lang);
const tx = t(incentivesTranslations, lang);

function findById(arr, id) { return arr.find(item => item.id === id); }
---

<Layout title={tx.metaTitle} description={tx.metaDescription} lang={lang}>
  <section aria-label="Business incentives hero" class="bg-primary-500 py-24">
    <div class="mx-auto max-w-3xl px-4 text-center sm:px-6 lg:px-8" data-aos="fade-up">
      <div class="mb-4 inline-block border border-white/20 px-4 py-1.5 text-xs font-medium text-white/70">{tx.badge}</div>
      <h1 class="mb-4 text-5xl font-extrabold text-white md:text-6xl">{tx.title}</h1>
      <p class="text-lg text-white/70">{tx.subtitle}</p>
    </div>
  </section>

  <Breadcrumb pages={[{ label: tx.breadcrumb1, href: "/business-incentives" }, { label: tx.breadcrumb2 }]} lang={lang} />

  {data.sections.map((section, si) => {
    const secTx = findById(tx.sections, section.id);
    return (
    <section aria-label={"Incentive section: " + secTx?.title} class={si % 2 === 0 ? "py-24" : "bg-surface py-24"}>
      <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
        <div class="mb-4 inline-block bg-primary-500 px-4 py-1.5 text-xs font-semibold text-white" data-aos="fade-up">{secTx?.badge}</div>
        <h2 class="mb-10 text-3xl font-bold text-primary-500" data-aos="fade-up" data-aos-delay="50">{secTx?.title}</h2>
        <div class={`grid gap-6 ${section.items.length <= 2 ? "md:grid-cols-2" : "md:grid-cols-3"}`}>
          {section.items.map((item, ii) => {
            const itemTx = findById(secTx?.items || [], item.id);
            return (
            <div class="card border-l-4 border-primary-500" data-aos="fade-up" data-aos-delay={ii * 100}>
              {item.number ? (
                <div class="mb-4 text-3xl font-black text-primary-500">{item.number}</div>
              ) : (
                <div class="mb-4 flex h-14 w-14 items-center justify-center rounded-lg bg-primary-500 text-white">
                  <svg aria-hidden="true" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4" /></svg>
                </div>
              )}
              <h3 class="mb-2 font-bold text-primary-500">{itemTx?.title}</h3>
              <p class="text-sm text-gray-500">{itemTx?.description}</p>
            </div>
            );
          })}
        </div>
      </div>
    </section>
    );
  })}

  <section aria-label="Contact for incentives" class="py-24">
    <div class="mx-auto max-w-3xl px-4 text-center sm:px-6 lg:px-8" data-aos="fade-up">
      <p class="mb-6 text-gray-600">{tx.cta.text}</p>
      <a href={langPrefix + data.cta.buttonLink} class="btn-primary">{tx.cta.buttonText}</a>
    </div>
  </section>
</Layout>


