---
import Layout from "../../layouts/Layout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import contact from "../../data/contact.json";
import { getStaticPaths, getLangFromParams, t, type LangCode } from "../../i18n";
import contactTranslations from "../../data/translations/contact.json";

export { getStaticPaths };
const lang = (Astro.props.lang || getLangFromParams(Astro.params)) as LangCode;
const ct = t(contactTranslations, lang);
---

<Layout title={ct.metaTitle} description={ct.metaDescription} lang={lang}>
  <section aria-label="Contact hero" class="bg-primary-500 pt-28 pb-24">
    <div class="mx-auto max-w-3xl px-4 text-center sm:px-6 lg:px-8" data-aos="fade-up">
      <div class="mb-4 inline-block border border-white/20 px-4 py-1.5 text-xs font-medium text-white/70">{ct.badge}</div>
      <h1 class="mb-4 text-5xl font-extrabold text-white md:text-6xl">{ct.title}</h1>
      <p class="text-lg text-white/70">{ct.subtitle}</p>
    </div>
  </section>

  <Breadcrumb pages={[{ label: ct.breadcrumb1 }]} lang={lang} />

  <section aria-label="Contact form and information" class="py-24">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-12 lg:grid-cols-2">
        <div>
          <h2 class="mb-2 text-3xl font-bold text-primary-500" data-aos="fade-up">{ct.formTitle}</h2>
          <p class="mb-8 text-gray-500" data-aos="fade-up" data-aos-delay="50">{ct.formSubtitle}</p>
          <form id="contact-form" class="space-y-5" data-aos="fade-up" data-aos-delay="100">
            <div>
              <label for="name" class="mb-1.5 block text-sm font-medium text-gray-700">{ct.nameLabel}</label>
              <input type="text" id="name" name="name" required class="w-full rounded-lg border border-gray-300 px-5 py-3 max-md:text-base md:text-sm focus:border-primary-500 focus:outline-none focus:ring-1 focus:ring-primary-500" placeholder="John Doe" />
            </div>
            <div>
              <label for="email" class="mb-1.5 block text-sm font-medium text-gray-700">{ct.emailLabel}</label>
              <input type="email" id="email" name="email" required class="w-full rounded-lg border border-gray-300 px-5 py-3 max-md:text-base md:text-sm focus:border-primary-500 focus:outline-none focus:ring-1 focus:ring-primary-500" placeholder="john@company.com" />
            </div>
            <div>
              <label for="company" class="mb-1.5 block text-sm font-medium text-gray-700">{ct.companyLabel}</label>
              <input type="text" id="company" name="company" class="w-full rounded-lg border border-gray-300 px-5 py-3 max-md:text-base md:text-sm focus:border-primary-500 focus:outline-none focus:ring-1 focus:ring-primary-500" placeholder="Company Name" />
            </div>
            <div>
              <label for="message" class="mb-1.5 block text-sm font-medium text-gray-700">{ct.messageLabel}</label>
              <textarea id="message" name="message" rows="5" required class="w-full rounded-lg border border-gray-300 px-5 py-3 max-md:text-base md:text-sm focus:border-primary-500 focus:outline-none focus:ring-1 focus:ring-primary-500" placeholder="Tell us about your inquiry..."></textarea>
            </div>
            <button type="submit" class="btn-primary w-full justify-center text-base" data-cta="contact_form_submit">{ct.sendLabel}</button>
            <div id="form-feedback" class="hidden text-sm"></div>
          </form>
        </div>

        <div>
          <h2 class="mb-2 text-3xl font-bold text-primary-500" data-aos="fade-up">{ct.infoTitle}</h2>
          <p class="mb-8 text-gray-500" data-aos="fade-up" data-aos-delay="50">{ct.infoSubtitle}</p>

          <div class="space-y-6" data-aos="fade-up" data-aos-delay="100">
            <div class="card border-l-4 border-primary-500 flex items-start gap-5">
              <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-lg bg-primary-500 text-white">
                <svg aria-hidden="true" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
              </div>
              <div>
                <h3 class="mb-1 font-bold text-primary-500">{ct.addressLabel}</h3>
                {ct.address.split(", ").map((line) => (
                  <p class="text-sm leading-relaxed text-gray-500">{line}</p>
                ))}
              </div>
            </div>

            <div class="card border-l-4 border-primary-500 flex items-start gap-5">
              <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-lg bg-primary-500 text-white">
                <svg aria-hidden="true" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
              </div>
              <div>
                <h3 class="mb-1 font-bold text-primary-500">{ct.phoneLabel}</h3>
                <p class="text-sm text-gray-500">{ct.phone}</p>
              </div>
            </div>

            <div class="card border-l-4 border-primary-500 flex items-start gap-5">
              <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-lg bg-primary-500 text-white">
                <svg aria-hidden="true" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
              </div>
              <div>
                <h3 class="mb-1 font-bold text-primary-500">{ct.emailLabelShort}</h3>
                <p class="text-sm text-gray-500">{ct.email}</p>
              </div>
            </div>

            <div class="card border-l-4 border-primary-500 flex items-start gap-5">
              <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-lg bg-primary-500 text-white">
                <svg aria-hidden="true" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
              </div>
              <div>
                <h3 class="mb-1 font-bold text-primary-500">{ct.hoursLabel}</h3>
                <p class="text-sm text-gray-500">{ct.hours}</p>
              </div>
            </div>
          </div>

          <div class="mt-8" data-aos="fade-up">
            <a href={contact.helpdeskUrl} target="_blank" rel="noopener noreferrer" class="btn-outline w-full justify-center">{ct.helpdeskText}</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section aria-label="Location map" class="h-96 w-full overflow-hidden">
    <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3851.17!2d120.2995!3d14.8246!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x339671a8708d4477%3A0xe112900ee7e2923f!2sSBDMC+%E4%B8%AD%E8%8F%AF%E9%96%8B%E7%99%BC%E4%B8%AD%E5%BF%83!5e0!3m2!1sen!2sph!4v1" width="100%" height="100%" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="SBDMC, Inc. Location Map"></iframe>
  </section>
</Layout>

<script define:vars={{ ct, lang }}>
  const form = document.getElementById("contact-form");
  const feedback = document.getElementById("form-feedback");
  const btn = form?.querySelector("button[type=submit]");

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!btn) return;
    const origText = btn.textContent;
    btn.textContent = ct.sending;
    btn.disabled = true;
    feedback?.classList.add("hidden");

    const data = new FormData(form);
    const payload = {
      type: "general",
      name: data.get("name"),
      email: data.get("email"),
      company: data.get("company") || "",
      message: data.get("message"),
      pageUrl: window.location.href,
      language: lang,
    };

    try {
      const res = await fetch("/api/contact", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });
      const json = await res.json();
      if (!res.ok) throw new Error(json.error);
      if (feedback) {
        feedback.textContent = ct.sendSuccess;
        feedback.className = "text-sm text-green-600";
      }
      form?.reset();
      setTimeout(() => feedback?.classList.add("hidden"), 3000);
    } catch {
      if (feedback) {
        feedback.textContent = ct.sendError;
        feedback.className = "text-sm text-red-600";
      }
    } finally {
      btn.textContent = origText;
      btn.disabled = false;
    }
  });
</script>

