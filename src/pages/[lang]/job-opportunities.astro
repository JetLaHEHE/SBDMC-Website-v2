---
import Layout from "../../layouts/Layout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import jobs from "../../data/jobs.json";
import { getStaticPaths, getLangFromParams, getLangPrefix, type LangCode, t } from "../../i18n";
import jobsTranslations from "../../data/translations/jobs.json";

export { getStaticPaths };
const lang = (Astro.props.lang || getLangFromParams(Astro.params)) as LangCode;
const langPrefix = getLangPrefix(lang);
const jt = t(jobsTranslations, lang);
---

<Layout title={jt.metaTitle} description={jt.metaDescription} lang={lang}>
  <section aria-label="Job opportunities hero" class="bg-primary-500 pt-28 pb-24">
    <div class="mx-auto max-w-3xl px-4 text-center sm:px-6 lg:px-8" data-aos="fade-up">
      <div class="mb-4 inline-block border border-white/20 px-4 py-1.5 text-xs font-medium text-white/70">{jt.badge}</div>
      <h1 class="mb-4 text-5xl font-extrabold text-white md:text-6xl">{jt.title}</h1>
      <p class="text-lg text-white/70">{jt.subtitle}</p>
    </div>
  </section>

  <Breadcrumb pages={[{ label: jt.breadcrumb1, href: "/job-opportunities" }, { label: jt.breadcrumb2 }]} lang={lang} />

  <section aria-label="Job listings" class="py-24">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <p class="mb-12 text-center text-lg text-gray-600" data-aos="fade-up">{jt.intro}</p>

      {jobs.listings.map((job) => (
        <div class="card border-l-4 border-primary-500 mb-6" data-aos="fade-up">
          <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
            <div class="flex items-start gap-4">
              <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-lg bg-primary-500 text-white">
                <svg aria-hidden="true" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
              </div>
              <div>
                <div class={`mb-1 inline-block px-3 py-0.5 text-xs font-semibold ${job.status === "open" ? "bg-accent-500 text-white" : "bg-gray-200 text-gray-500"}`}>{job.status === "open" ? jt.statusOpen : jt.statusClosed}</div>
                <h3 class="text-xl font-bold text-primary-500">{job.title}</h3>
                <p class="text-sm text-gray-500">{job.company} &middot; {job.type} &middot; {job.location}</p>
                <p class="mt-2 text-sm text-gray-600">{job.description}</p>
              </div>
            </div>
            {job.status === "open" && (
              <div>
                <button class="btn-primary shrink-0 text-center text-sm cursor-pointer" data-apply-toggle>
                  {jt.applyNow}
                </button>
                <div class="mt-4 hidden space-y-3 border-t border-gray-200 pt-4" data-apply-form>
                  <p class="text-sm font-semibold text-primary-500">{jt.applicationFormTitle}</p>
                  <input type="text" placeholder={jt.applicationNameLabel} required class="w-full rounded-lg border border-gray-300 px-4 py-2 text-sm focus:border-primary-500 focus:outline-none focus:ring-1 focus:ring-primary-500" data-apply-name />
                  <input type="email" placeholder={jt.applicationEmailLabel} required class="w-full rounded-lg border border-gray-300 px-4 py-2 text-sm focus:border-primary-500 focus:outline-none focus:ring-1 focus:ring-primary-500" data-apply-email />
                  <input type="tel" placeholder={jt.applicationPhoneLabel} class="w-full rounded-lg border border-gray-300 px-4 py-2 text-sm focus:border-primary-500 focus:outline-none focus:ring-1 focus:ring-primary-500" data-apply-phone />
                  <textarea placeholder={jt.applicationCoverLabel} rows="4" required class="w-full rounded-lg border border-gray-300 px-4 py-2 text-sm focus:border-primary-500 focus:outline-none focus:ring-1 focus:ring-primary-500" data-apply-cover></textarea>
                  <button class="btn-primary w-full justify-center text-sm" data-cta="job_application_submit" data-apply-submit>{jt.applicationSubmit}</button>
                  <p class="hidden text-sm" data-apply-feedback></p>
                </div>
              </div>
            )}
          </div>
        </div>
      ))}

      <div class="mt-12 bg-primary-500 p-8 text-center text-white" data-aos="fade-up">
        <h3 class="mb-3 text-2xl font-bold">{jt.ctaTitle}</h3>
        <p class="mb-6 text-white/80">{jt.ctaText}</p>
        <a href={`mailto:${jobs.ctaEmail}`} class="btn-white">{jt.emailResume}</a>
      </div>
    </div>
  </section>
</Layout>

<script define:vars={{ jt, lang }}>
  document.addEventListener("click", (e) => {
    const toggle = e.target.closest("[data-apply-toggle]");
    if (toggle) {
      const form = toggle.parentElement?.querySelector("[data-apply-form]");
      form?.classList.toggle("hidden");
    }
  });

  document.addEventListener("click", async (e) => {
    const btn = e.target.closest("[data-apply-submit]");
    if (!btn) return;
    const container = btn.closest("[data-apply-form]");
    if (!container) return;
    const feedback = container.querySelector("[data-apply-feedback]");
    const name = container.querySelector("[data-apply-name]");
    const email = container.querySelector("[data-apply-email]");
    const phone = container.querySelector("[data-apply-phone]");
    const cover = container.querySelector("[data-apply-cover]");
    if (!name?.value || !email?.value || !cover?.value) return;
    const origText = btn.textContent;
    btn.textContent = jt.sending || "Sending...";
    btn.disabled = true;
    if (feedback) feedback.className = "hidden text-sm";

    const position = container.closest("[class*=card]")?.querySelector("h3")?.textContent || "";

    const payload = {
      type: "job_application",
      name: name.value,
      email: email.value,
      phone: phone?.value || "",
      position,
      coverLetter: cover.value,
      pageUrl: window.location.href,
      language: lang,
    };

    try {
      const res = await fetch("/api/contact", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });
      const json = await res.json();
      if (!res.ok) throw new Error(json.error);
      if (feedback) {
        feedback.textContent = jt.applicationSuccess;
        feedback.className = "text-sm text-green-600";
      }
      name.value = "";
      email.value = "";
      if (phone) phone.value = "";
      if (cover) cover.value = "";
      container.classList.add("hidden");
      setTimeout(() => { if (feedback) feedback.className = "hidden text-sm"; }, 3000);
    } catch {
      if (feedback) {
        feedback.textContent = jt.applicationError;
        feedback.className = "text-sm text-red-600";
      }
    } finally {
      btn.textContent = origText;
      btn.disabled = false;
    }
  });
</script>


