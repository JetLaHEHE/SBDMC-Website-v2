---
import Layout from "../../layouts/Layout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import { getStaticPaths, getLangFromParams, type LangCode, t } from "../../i18n";
import handyGuideTranslations from "../../data/translations/handy-guide.json";

export { getStaticPaths };
const lang = (Astro.props.lang || getLangFromParams(Astro.params)) as LangCode;
const tx = t(handyGuideTranslations, lang);
---

<Layout title={tx.title} description={tx.subtitle} lang={lang}>
  <section aria-label="Handy guide hero" class="bg-primary-500 py-24">
    <div class="mx-auto max-w-3xl px-4 text-center sm:px-6 lg:px-8" data-aos="fade-up">
      <div class="mb-4 inline-block border border-white/20 px-4 py-1.5 text-xs font-medium text-white/70">{tx.badge}</div>
      <h1 class="mb-4 text-5xl font-extrabold text-white md:text-6xl">{tx.title}</h1>
      <p class="text-lg text-white/70">{tx.subtitle}</p>
    </div>
  </section>

  <Breadcrumb pages={[{ label: tx.breadcrumb }]} lang={lang} />

  <section aria-label="Emergency contacts and park rules" class="py-24">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <div class="mb-10 border-l-4 border-accent-500 bg-red-50 p-7" data-aos="fade-up">
        <div class="mb-4 inline-block bg-accent-500 px-4 py-1.5 text-xs font-bold text-white uppercase tracking-wider">{tx.emergencyBadge}</div>
        <h2 class="mb-4 text-2xl font-bold text-primary-500">{tx.emergencyTitle}</h2>
        <div class="grid gap-4 sm:grid-cols-2">
          {tx.emergencyItems.map((item) => (
            <div class="border bg-white p-4">
              <div class="text-lg font-bold text-accent-500">{item.number}</div>
              <div class="text-sm text-gray-500">{item.label}</div>
            </div>
          ))}
        </div>
      </div>

      <div class="mb-10 grid gap-6 md:grid-cols-2" data-aos="fade-up">
        <div class="card border-l-4 border-primary-500">
          <h3 class="mb-4 text-lg font-bold text-primary-500">{tx.importantNumbersTitle}</h3>
          <div class="space-y-3">
            {tx.importantNumbers.map((item) => (
              <div class="flex items-center justify-between border-b border-gray-100 pb-2">
                <span class="text-sm text-gray-600">{item.label}</span>
                <span class="font-bold text-primary-500">{item.number}</span>
              </div>
            ))}
          </div>
        </div>

        <div class="card border-l-4 border-primary-500">
          <h3 class="mb-4 text-lg font-bold text-primary-500">{tx.officeHoursTitle}</h3>
          <p class="mb-3 text-sm text-gray-600">{tx.officeHoursText}</p>
          <div class="flex items-center justify-between bg-surface p-3">
            <span class="text-sm font-medium text-primary-500">{tx.officeHoursDays}</span>
            <span class="text-sm text-gray-600">{tx.officeHoursTime}</span>
          </div>
          <p class="mt-2 text-xs text-gray-400">{tx.officeHoursClosed}</p>
        </div>
      </div>

      <div class="card border-l-4 border-primary-500 mb-10" data-aos="fade-up">
        <h3 class="mb-4 text-lg font-bold text-primary-500">{tx.parkRulesTitle}</h3>
        <div class="grid gap-3 sm:grid-cols-2">
          {tx.rules.map((rule) => (
            <div class="flex items-start gap-3 bg-surface p-4">
              <svg aria-hidden="true" class="mt-0.5 h-5 w-5 shrink-0 text-primary-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
              <span class="text-sm text-gray-600">{rule}</span>
            </div>
          ))}
        </div>
      </div>

      <div class="bg-primary-500 p-7 text-white" data-aos="fade-up">
        <h3 class="mb-3 text-lg font-bold">{tx.usefulLinksTitle}</h3>
        <div class="flex flex-wrap gap-3">
          <a href="https://sbdmcinc.freshdesk.com/support/home" target="_blank" rel="noopener noreferrer" class="border border-white/40 px-5 py-2.5 text-sm font-medium text-white transition-all hover:bg-white/20">{tx.helpdeskLink}</a>
          <a href="https://eipp.unionbankph.com/EIPPHUB" target="_blank" rel="noopener noreferrer" class="border border-white/40 px-5 py-2.5 text-sm font-medium text-white transition-all hover:bg-white/20">{tx.ebillingLink}</a>
        </div>
      </div>
    </div>
  </section>
</Layout>


