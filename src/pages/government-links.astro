---
import Layout from "../layouts/Layout.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import data from "../data/government-links.json";
import { getStaticPaths, getLangFromParams, type LangCode, t } from "../i18n";
import govLinksTranslations from "../data/translations/government-links.json";

export { getStaticPaths };
const lang = (Astro.props.lang || getLangFromParams(Astro.params)) as LangCode;
const tx = t(govLinksTranslations, lang);

function findById(arr, id) { return arr.find(item => item.id === id); }
---

<Layout title={tx.metaTitle} description={tx.metaDescription} lang={lang}>
  <section aria-label="Government links hero" class="bg-primary-500 py-24">
    <div class="mx-auto max-w-3xl px-4 text-center sm:px-6 lg:px-8" data-aos="fade-up">
      <div class="mb-4 inline-block border border-white/20 px-4 py-1.5 text-xs font-medium text-white/70">{tx.badge}</div>
      <h1 class="mb-4 text-5xl font-extrabold text-white md:text-6xl">{tx.title}</h1>
      <p class="text-lg text-white/70">{tx.subtitle}</p>
    </div>
  </section>

  <Breadcrumb pages={[{ label: tx.breadcrumb1, href: "/faq" }, { label: tx.breadcrumb2 }]} lang={lang} />

  <section aria-label="Government links listing" class="py-24">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {data.links.map((link, i) => {
          const linkTx = findById(tx.links, link.id);
          return (
          <a href={link.url} target="_blank" rel="noopener noreferrer" class="card border-l-4 border-primary-500 block transition-all hover:shadow-lg hover:-translate-y-1" data-aos="fade-up" data-aos-delay={i * 50}>
            <div class="mb-2 inline-block bg-primary-500 px-3 py-0.5 text-xs font-semibold text-white">{linkTx?.category}</div>
            <h3 class="mb-1 text-lg font-bold text-primary-500">{linkTx?.name}</h3>
            <p class="mb-2 text-sm font-medium text-gray-400">{link.acronym}</p>
            <p class="text-sm leading-relaxed text-gray-500">{linkTx?.description}</p>
            <div class="mt-3 text-sm font-semibold text-primary-500">{tx.visitText}</div>
          </a>
          );
        })}
      </div>
    </div>
  </section>
</Layout>


