---
import Layout from "../layouts/Layout.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import data from "../data/government-links.json";
---

<Layout title="Government Links" description="Access key government agencies and resources relevant to locators in the Subic Bay Freeport Zone.">
  <section class="bg-primary-500 py-24">
    <div class="mx-auto max-w-3xl px-4 text-center sm:px-6 lg:px-8" data-aos="fade-up">
      <div class="mb-4 inline-block border border-white/20 px-4 py-1.5 text-xs font-medium text-white/70">{data.badge}</div>
      <h1 class="mb-4 text-5xl font-extrabold text-white md:text-6xl">{data.title}</h1>
      <p class="text-lg text-white/70">{data.subtitle}</p>
    </div>
  </section>

  <Breadcrumb pages={[{ label: "Why Us", href: "/faq" }, { label: "Government Links" }]} />

  <section class="py-24">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {data.links.map((link, i) => (
          <a href={link.url} target="_blank" rel="noopener noreferrer" class="card border-l-4 border-primary-500 block transition-all hover:shadow-lg hover:-translate-y-1" data-aos="fade-up" data-aos-delay={i * 50}>
            <div class="mb-2 inline-block bg-primary-500 px-3 py-0.5 text-xs font-semibold text-white">{link.category}</div>
            <h3 class="mb-1 text-lg font-bold text-primary-500">{link.name}</h3>
            <p class="mb-2 text-sm font-medium text-gray-400">{link.acronym}</p>
            <p class="text-sm leading-relaxed text-gray-500">{link.description}</p>
            <div class="mt-3 text-sm font-semibold text-primary-500">Visit Website &rarr;</div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
