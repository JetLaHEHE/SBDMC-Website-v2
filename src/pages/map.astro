---
import Layout from "../layouts/Layout.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
---

<Layout title="Location Map" description="Find Subic Bay Gateway Park on the map in the Subic Bay Freeport Zone, Philippines.">
  <section aria-label="Location map hero" class="bg-primary-500 py-24">
    <div class="mx-auto max-w-3xl px-4 text-center sm:px-6 lg:px-8" data-aos="fade-up">
      <div class="mb-4 inline-block border border-white/20 px-4 py-1.5 text-xs font-medium text-white/70">Location</div>
      <h1 class="mb-4 text-5xl font-extrabold text-white md:text-6xl">Location Map</h1>
      <p class="text-lg text-white/70">Find us at the Subic Bay Freeport Zone</p>
    </div>
  </section>

  <Breadcrumb pages={[{ label: "Location Map" }]} />

  <section aria-label="Map and directions" class="py-24">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <div class="mb-8" data-aos="fade-up">
        <div class="mb-6">
          <h2 class="text-2xl font-bold text-primary-500">Our Location</h2>
          <p class="mt-1 text-gray-500">Argonaut Highway cor. Rizal Highway, Subic Bay Gateway Park, Subic Bay Freeport Zone, 2222</p>
        </div>
        <div class="aspect-[16/9] w-full overflow-hidden shadow-lg">
          <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3850.634297273158!2d120.27188931537355!3d14.830276289659852!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3396716f8c6c1e51%3A0x8c6b5c5b5c5b5c5b!2sSubic%20Bay%20Gateway%20Park!5e0!3m2!1sen!2sph!4v1" width="100%" height="100%" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="SBGP Location Map" class="absolute inset-0"></iframe>
        </div>
      </div>

      <h2 class="mb-6 text-2xl font-bold text-primary-500" data-aos="fade-up">Getting Here</h2>
      <div class="grid gap-6 md:grid-cols-2">
        <div class="card border-l-4 border-primary-500" data-aos="fade-up">
          <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-lg bg-primary-500 text-white">
            <svg aria-hidden="true" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
          </div>
          <h3 class="mb-1 font-bold text-primary-500">By Air</h3>
          <p class="text-sm text-gray-500">Subic Bay International Airport is located nearby, with connecting flights from Manila and other major cities.</p>
        </div>
        <div class="card border-l-4 border-primary-500" data-aos="fade-up" data-aos-delay="100">
          <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-lg bg-primary-500 text-white">
            <svg aria-hidden="true" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" /></svg>
          </div>
          <h3 class="mb-1 font-bold text-primary-500">By Land</h3>
          <p class="text-sm text-gray-500">Accessible via SCTEX and NLEX. Approximately 2-3 hours from Manila.</p>
        </div>
        <div class="card border-l-4 border-primary-500" data-aos="fade-up">
          <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-lg bg-primary-500 text-white">
            <svg aria-hidden="true" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
          </div>
          <h3 class="mb-1 font-bold text-primary-500">By Sea</h3>
          <p class="text-sm text-gray-500">Subic Bay Freeport Zone has a major seaport with regular shipping services to international destinations.</p>
        </div>
        <div class="card border-l-4 border-primary-500" data-aos="fade-up" data-aos-delay="100">
          <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-lg bg-primary-500 text-white">
            <svg aria-hidden="true" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" /></svg>
          </div>
          <h3 class="mb-1 font-bold text-primary-500">Public Transport</h3>
          <p class="text-sm text-gray-500">Buses and jeepneys operate regularly from Olongapo City and nearby areas to the Freeport Zone.</p>
        </div>
      </div>
    </div>
  </section>
</Layout>
