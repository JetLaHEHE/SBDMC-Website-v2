---
import Layout from "../layouts/Layout.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import { getStaticPaths, getLangFromParams, type LangCode, t } from "../i18n";
import rentalInformationTranslations from "../data/translations/rental-information.json";

export { getStaticPaths };
const lang = (Astro.props.lang || getLangFromParams(Astro.params)) as LangCode;
const tx = t(rentalInformationTranslations, lang);
---

<Layout title={tx.title} description={tx.subtitle} lang={lang}>
  <section aria-label="Rental information hero" class="bg-primary-500 py-24">
    <div class="mx-auto max-w-3xl px-4 text-center sm:px-6 lg:px-8" data-aos="fade-up">
      <div class="mb-4 inline-block border border-white/20 px-4 py-1.5 text-xs font-medium text-white/70">{tx.badge}</div>
      <h1 class="mb-4 text-5xl font-extrabold text-white md:text-6xl">{tx.title}</h1>
      <p class="text-lg text-white/70">{tx.subtitle}</p>
    </div>
  </section>

  <Breadcrumb pages={[{ label: tx.breadcrumbProducts, href: "/rental-information" }, { label: tx.breadcrumbRental }]} lang={lang} />

  <section aria-label="Rental details" class="py-24">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-6 md:grid-cols-2">
        <div class="card border-l-4 border-primary-500" data-aos="fade-up">
          <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-lg bg-primary-500 text-white">
            <svg aria-hidden="true" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
          </div>
          <h3 class="mb-2 text-lg font-bold text-primary-500">{tx.leaseTermsTitle}</h3>
          <p class="text-sm text-gray-500">{tx.leaseTermsText}</p>
        </div>
        <div class="card border-l-4 border-primary-500" data-aos="fade-up" data-aos-delay="100">
          <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-lg bg-primary-500 text-white">
            <svg aria-hidden="true" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
          </div>
          <h3 class="mb-2 text-lg font-bold text-primary-500">{tx.rentalRatesTitle}</h3>
          <p class="text-sm text-gray-500">{tx.rentalRatesText}</p>
        </div>
        <div class="card border-l-4 border-primary-500" data-aos="fade-up">
          <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-lg bg-primary-500 text-white">
            <svg aria-hidden="true" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
          </div>
          <h3 class="mb-2 text-lg font-bold text-primary-500">{tx.inclusionsTitle}</h3>
          <ul class="space-y-1 text-sm text-gray-500">
            {tx.inclusions.map((item) => (
              <li>&bull; {item}</li>
            ))}
          </ul>
        </div>
        <div class="card border-l-4 border-primary-500" data-aos="fade-up" data-aos-delay="100">
          <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-lg bg-primary-500 text-white">
            <svg aria-hidden="true" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
          </div>
          <h3 class="mb-2 text-lg font-bold text-primary-500">{tx.requirementsTitle}</h3>
          <ul class="space-y-1 text-sm text-gray-500">
            {tx.requirements.map((item) => (
              <li>&bull; {item}</li>
            ))}
          </ul>
        </div>
      </div>

      <div class="mt-12 bg-primary-500 p-8 text-center text-white" data-aos="fade-up">
        <h3 class="mb-3 text-2xl font-bold">{tx.ctaTitle}</h3>
        <p class="mb-6 text-white/80">{tx.ctaText}</p>
        <a href="/contact" class="btn-white">{tx.ctaButton}</a>
      </div>
    </div>
  </section>
</Layout>


