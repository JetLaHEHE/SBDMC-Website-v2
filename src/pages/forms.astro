---
import Layout from "../layouts/Layout.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import { getStaticPaths, getLangFromParams, type LangCode, t } from "../i18n";
import formsTranslations from "../data/translations/forms.json";

export { getStaticPaths };
const lang = (Astro.props.lang || getLangFromParams(Astro.params)) as LangCode;
const tx = t(formsTranslations, lang);
---

<Layout title={tx.title} description={tx.subtitle} lang={lang}>
  <section aria-label="Forms hero" class="bg-primary-500 py-24">
    <div class="mx-auto max-w-3xl px-4 text-center sm:px-6 lg:px-8" data-aos="fade-up">
      <div class="mb-4 inline-block border border-white/20 px-4 py-1.5 text-xs font-medium text-white/70">{tx.badge}</div>
      <h1 class="mb-4 text-5xl font-extrabold text-white md:text-6xl">{tx.title}</h1>
      <p class="text-lg text-white/70">{tx.subtitle}</p>
    </div>
  </section>

  <Breadcrumb pages={[{ label: tx.breadcrumbProducts, href: "/forms" }, { label: tx.breadcrumbForms }]} lang={lang} />

  <section aria-label="Downloads listing" class="py-24">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">

      <div class="mb-16">
        <h2 class="mb-8 text-2xl font-bold text-primary-500" data-aos="fade-up">{tx.generalDownloadsTitle}</h2>
