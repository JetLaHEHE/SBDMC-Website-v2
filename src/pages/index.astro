---
import Layout from "../layouts/Layout.astro";
import hero from "../data/hero.json";
import news from "../data/news.json";
import sbdmcBg from "../assets/sbdmc.jpg";
import FacebookFeed from "../components/FacebookFeed.astro";
const stats = hero.stats;
const newsItems = news.items;
---

<Layout title="Subic Bay Gateway Park - Premier Industrial Park" description="Subic Bay Gateway Park — a premier business and industrial park in the Subic Bay Freeport Zone, Philippines. Explore world-class infrastructure, tax incentives, and strategic location.">
  <section aria-label="Hero banner" class="relative min-h-[90vh] overflow-hidden pt-24">
    <img src={sbdmcBg.src} alt="" class="absolute inset-0 h-full w-full object-cover" />
    <div class="absolute inset-0 bg-primary-500/70"></div>
    <div class="absolute top-0 right-0 h-[400px] w-[400px] translate-x-1/3 -translate-y-1/4 rounded-full bg-accent-500/10 blur-3xl"></div>
    <div class="absolute bottom-0 left-0 h-[300px] w-[300px] -translate-x-1/4 translate-y-1/4 rounded-full bg-accent-500/10 blur-3xl"></div>
    <div class="absolute top-1/3 left-1/4 h-1 w-20 bg-accent-500/30"></div>
    <div class="absolute bottom-1/4 right-1/4 h-1 w-32 bg-accent-500/30"></div>
    <div class="relative mx-auto flex min-h-[90vh] max-w-6xl flex-col items-center justify-center px-4 text-center sm:px-6 lg:px-8">
      <div data-aos="fade-up">
        <div class="mb-6 inline-flex items-center gap-2 border border-white/20 px-5 py-2 text-sm font-medium text-white/80">
          <span class="flex h-2 w-2 bg-primary-500"></span>
          {hero.badge}
        </div>
      </div>
      <h1 data-aos="fade-up" data-aos-delay="100" class="mb-6 max-w-4xl text-5xl font-extrabold leading-tight text-white md:text-7xl lg:text-8xl text-balance">
        {hero.headline}
        <span class="text-accent-500">{hero.headlineHighlight}</span>
      </h1>
      <p data-aos="fade-up" data-aos-delay="200" class="mb-10 max-w-2xl text-lg text-white/70 md:text-xl">
        {hero.subtitle}
      </p>
      <div data-aos="fade-up" data-aos-delay="300" class="flex flex-wrap justify-center gap-4">
        <a href={hero.ctaPrimary.link} class="btn-primary">{hero.ctaPrimary.text}</a>
        <a href={hero.ctaSecondary.link} class="inline-flex items-center gap-2 rounded-lg border-2 border-white px-7 py-3 font-semibold text-white transition-all hover:bg-white hover:text-primary-500">{hero.ctaSecondary.text}</a>
      </div>
    </div>
  </section>

  <section aria-label="Key statistics" class="bg-primary-800 py-14">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-8 md:grid-cols-4">
        {stats.map((stat, i) => (
          <div class="text-center" data-aos="fade-up" data-aos-delay={i * 100}>
             <div class="mb-1 text-4xl font-bold text-primary-300 md:text-5xl">{stat.value}</div>
            <div class="text-sm font-medium text-gray-400">{stat.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section aria-label="Services" class="bg-surface py-24">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="mb-16" data-aos="fade-up">
        <h2 class="section-title text-center">{hero.servicesTitle}</h2>
        <p class="section-subtitle text-center">{hero.servicesSubtitle}</p>
      </div>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        <a href="/rental-information" class="card" data-aos="fade-up">
          <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-lg bg-primary-500 text-white">
            <svg aria-hidden="true" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" /></svg>
          </div>
          <h3 class="mb-2 text-lg font-bold text-primary-500">Rental Information</h3>
          <p class="text-sm text-gray-500">Explore available spaces for lease within the park.</p>
        </a>
        <a href="/business-services" class="card" data-aos="fade-up" data-aos-delay="100">
          <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-lg bg-primary-500 text-white">
            <svg aria-hidden="true" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
          </div>
          <h3 class="mb-2 text-lg font-bold text-primary-500">Business Services</h3>
          <p class="text-sm text-gray-500">Comprehensive support for your business operations.</p>
        </a>
        <a href="/job-opportunities" class="card" data-aos="fade-up" data-aos-delay="200">
          <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-lg bg-primary-500 text-white">
            <svg aria-hidden="true" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
          </div>
          <h3 class="mb-2 text-lg font-bold text-primary-500">Job Opportunities</h3>
          <p class="text-sm text-gray-500">Find career opportunities within the park.</p>
        </a>
        <a href="/forms" class="card" data-aos="fade-up">
          <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-lg bg-primary-500 text-white">
            <svg aria-hidden="true" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
          </div>
          <h3 class="mb-2 text-lg font-bold text-primary-500">Forms & Downloads</h3>
          <p class="text-sm text-gray-500">Download forms, brochures, and handy guides.</p>
        </a>
        <a href="/rfid" class="card" data-aos="fade-up" data-aos-delay="100">
          <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-lg bg-primary-500 text-white">
            <svg aria-hidden="true" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" /></svg>
          </div>
          <h3 class="mb-2 text-lg font-bold text-primary-500">RFID Access</h3>
          <p class="text-sm text-gray-500">Guidelines, requirements, and forms for RFID access passes.</p>
        </a>
        <a href="/business-incentives" class="card" data-aos="fade-up" data-aos-delay="200">
          <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-lg bg-primary-500 text-white">
            <svg aria-hidden="true" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
          </div>
          <h3 class="mb-2 text-lg font-bold text-primary-500">Business Incentives</h3>
          <p class="text-sm text-gray-500">Learn about tax breaks and incentives for locators.</p>
        </a>
        <a href="/for-lease" class="card" data-aos="fade-up" data-aos-delay="200">
          <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-lg bg-primary-500 text-white">
            <svg aria-hidden="true" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" /></svg>
          </div>
          <h3 class="mb-2 text-lg font-bold text-primary-500">For Lease</h3>
          <p class="text-sm text-gray-500">View available properties for lease in the park.</p>
        </a>
      </div>
    </div>
  </section>

  <section aria-label="Latest news" class="py-24">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="mb-16" data-aos="fade-up">
        <h2 class="section-title text-center">{news.title}</h2>
        <p class="section-subtitle text-center">{news.subtitle}</p>
      </div>
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        {newsItems.map((item, i) => (
          <a href={item.url} target="_blank" rel="noopener noreferrer" class="card pt-6" data-aos="fade-up" data-aos-delay={i * 100}>
            <div class="mb-3 inline-block bg-accent-500 px-3 py-1 text-xs font-semibold text-white">{item.category}</div>
            <h3 class="font-bold text-primary-500">{item.title}</h3>
            <p class="mt-1 text-sm text-gray-500">{item.description}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- <FacebookFeed /> -->

  <section aria-label="Features" class="bg-surface py-24">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="mb-16" data-aos="fade-up">
        <h2 class="section-title text-center">{hero.featuresTitle}</h2>
        <p class="section-subtitle text-center">{hero.featuresSubtitle}</p>
      </div>
      <div class="grid gap-8 md:grid-cols-3">
        <div class="card" data-aos="fade-up">
          <div class="mb-5 flex h-14 w-14 items-center justify-center rounded-lg bg-primary-500 text-white">
            <svg aria-hidden="true" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
          </div>
          <h3 class="mb-3 text-xl font-bold text-primary-500">Strategic Location</h3>
          <p class="leading-relaxed text-gray-500">Situated in the Subic Bay Freeport Zone with direct access to international shipping routes, airport, and expressways.</p>
          <a href="/map" class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-primary-500 transition-all hover:text-primary-600 hover:gap-2">View Location <span>&rarr;</span></a>
        </div>
        <div class="card" data-aos="fade-up" data-aos-delay="100">
          <div class="mb-5 flex h-14 w-14 items-center justify-center rounded-lg bg-primary-500 text-white">
            <svg aria-hidden="true" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
          </div>
          <h3 class="mb-3 text-xl font-bold text-primary-500">World-Class Infrastructure</h3>
          <p class="leading-relaxed text-gray-500">Reliable power, water, high-speed fiber optic internet, and modern facilities with 24/7 security.</p>
          <a href="/description" class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-primary-500 transition-all hover:text-primary-600 hover:gap-2">Learn More <span>&rarr;</span></a>
        </div>
        <div class="card" data-aos="fade-up" data-aos-delay="200">
          <div class="mb-5 flex h-14 w-14 items-center justify-center rounded-lg bg-primary-500 text-white">
            <svg aria-hidden="true" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
          </div>
          <h3 class="mb-3 text-xl font-bold text-primary-500">Business Incentives</h3>
          <p class="leading-relaxed text-gray-500">Tax holidays, duty-free imports, 100% foreign ownership allowed, and streamlined registration processes.</p>
          <a href="/business-incentives" class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-primary-500 transition-all hover:text-primary-600 hover:gap-2">View Incentives <span>&rarr;</span></a>
        </div>
      </div>
    </div>
  </section>

  <section aria-label="Call to action" class="bg-primary-500 py-24">
    <div class="mx-auto max-w-3xl px-4 text-center sm:px-6 lg:px-8">
      <h2 class="mb-6 text-4xl font-bold text-white md:text-5xl" data-aos="fade-up">{hero.ctaTitle}</h2>
      <p class="mb-10 text-lg text-white/80" data-aos="fade-up" data-aos-delay="100">{hero.ctaSubtitle}</p>
      <div class="flex flex-wrap justify-center gap-4" data-aos="fade-up" data-aos-delay="200">
        <a href="/contact" class="btn-white">{hero.ctaButton}</a>
        <a href="/business-incentives" class="rounded-lg border-2 border-white/50 px-7 py-3 text-base font-semibold text-white transition-all hover:bg-white/10 hover:-translate-y-0.5">View Incentives</a>
      </div>
    </div>
  </section>
</Layout>
