---
import { getLangPrefix, t, type LangCode } from "../i18n";
import headerTranslations from "../data/translations/header.json";
import navTranslations from "../data/translations/navigation.json";
import LangSwitcher from "./LangSwitcher.astro";

const { currentPath = "/", lang = "en" } = Astro.props as { currentPath?: string; lang?: LangCode };
const ht = t(headerTranslations, lang);
const navItems = navTranslations[lang] || navTranslations.en;
const langPrefix = getLangPrefix(lang);

function linkHref(href: string): string {
  return langPrefix + href;
}
function isActive(href: string): boolean {
  const prefixed = langPrefix + href;
  if (prefixed === "/en/") return true;
  if (prefixed === "/en") return currentPath === "/en" || currentPath === "/en/";
  return currentPath === prefixed || currentPath.startsWith(prefixed + "/") || currentPath.startsWith(prefixed + "#");
}
function linkClass(href: string, base = false): string {
  const active = isActive(href);
  if (base) {
return active
    ? "relative whitespace-nowrap rounded-lg px-2 py-2 text-sm font-medium text-primary-500 transition-all"
    : "relative whitespace-nowrap rounded-lg px-2 py-2 text-sm font-medium text-gray-600 transition-all hover:text-primary-500";
  }
  return active
    ? "block whitespace-nowrap rounded-lg px-3 py-2 text-sm text-primary-600 bg-accent-50 transition-all"
    : "block whitespace-nowrap rounded-lg px-3 py-2 text-sm text-gray-600 transition-all hover:bg-accent-50 hover:text-accent-600";
}
---

<header id="site-header" class="fixed top-0 z-50 w-full border-b border-gray-100 bg-white/95 backdrop-blur-md transition-all pt-[env(safe-area-inset-top)]">
  <nav class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3 sm:px-6 lg:px-8">
    <a href={linkHref("/")} class="flex items-center gap-3">
      <img src="/images/logo.png" alt={ht.logoAlt} class="h-9 w-auto" />
      <div class="hidden sm:block">
        <div class="text-base font-bold text-primary-500">{ht.brand}</div>
        <div class="-mt-0.5 text-[10px] font-medium tracking-wider text-gray-400 uppercase">{ht.tagline}</div>
      </div>
    </a>

    <div class="hidden items-center gap-1 lg:flex">
      {
        navItems.map((item) =>
          item.children ? (
            <div class="group relative">
              <button class="flex whitespace-nowrap items-center gap-1 rounded-lg px-3 py-2 text-sm font-medium text-gray-600 transition-all hover:text-primary-500" aria-haspopup="true">
                {item.label}
                <svg aria-hidden="true" class="h-3.5 w-3.5 transition-transform group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
              </button>
              <div class="invisible absolute left-0 top-full z-50 w-56 origin-top-right translate-y-2 rounded-lg border border-gray-100 bg-white p-1 shadow-lg opacity-0 transition-all duration-200 group-hover:visible group-hover:translate-y-1 group-hover:opacity-100 group-hover:delay-150 group-focus-within:visible group-focus-within:translate-y-1 group-focus-within:opacity-100">
                {item.children.map((child) => (
                  <a href={linkHref(child.href)} class={linkClass(child.href)}>
                    {child.label}
                  </a>
                ))}
              </div>
            </div>
          ) : (
            <a href={linkHref(item.href)} class={linkClass(item.href, true)} aria-current={isActive(item.href) ? "page" : undefined}>
              {item.label}
            </a>
          ),
        )
      }
    </div>

    <div class="flex items-center gap-1">
      <LangSwitcher currentLang={lang} currentPath={currentPath} />
      <button id="search-toggle" class="flex h-9 w-9 items-center justify-center rounded-lg text-gray-500 transition-all hover:bg-gray-100" aria-label={ht.search}>
        <svg aria-hidden="true" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
      </button>
      <button id="menu-toggle" class="flex h-9 w-9 items-center justify-center rounded-lg text-gray-500 hover:bg-gray-100 lg:hidden" aria-label={ht.toggleMenu} aria-expanded="false" aria-controls="mobile-menu">
        <svg aria-hidden="true" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" /></svg>
      </button>
    </div>
  </nav>

  <div id="mobile-menu" class="hidden border-t border-gray-100 bg-white lg:hidden max-h-[calc(100dvh-4rem)] overflow-y-auto">
    <div class="space-y-1 px-4 py-4">
      {
        navItems.map((item) => {
          if (item.children) {
            return <div>
              <div class="rounded-lg px-3 py-2 text-sm font-medium text-gray-400">{item.label}</div>
              <div class="ml-4 space-y-0.5 pb-2">
                {item.children.map((child) => {
                  return <a href={linkHref(child.href)} class={linkClass(child.href)}>
                    {child.label}
                  </a>;
                })}
              </div>
            </div>;
          }
          return <a href={linkHref(item.href)} class={linkClass(item.href, true)}>
            {item.label}
          </a>;
        })
      }
    </div>
  </div>
</header>

<script>
  const menuToggle = document.getElementById("menu-toggle");
  const mobileMenu = document.getElementById("mobile-menu");
  const backdrop = document.createElement("div");
  backdrop.id = "mobile-backdrop";
  backdrop.style.cssText = "position:fixed;inset:0;background:rgba(0,0,0,0.5);z-index:49;display:none;-webkit-backdrop-filter:blur(4px);backdrop-filter:blur(4px)";
  document.body.appendChild(backdrop);

  function closeMobileMenu() {
    mobileMenu?.classList.add("hidden");
    menuToggle?.setAttribute("aria-expanded", "false");
    backdrop.style.display = "none";
    document.body.style.overflow = "";
  }

  menuToggle?.addEventListener("click", () => {
    const isOpen = !mobileMenu.classList.toggle("hidden");
    menuToggle.setAttribute("aria-expanded", String(isOpen));
    backdrop.style.display = isOpen ? "block" : "none";
    document.body.style.overflow = isOpen ? "hidden" : "";
  });

  backdrop.addEventListener("click", closeMobileMenu);

  mobileMenu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", closeMobileMenu);
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && mobileMenu && !mobileMenu.classList.contains("hidden")) {
      closeMobileMenu();
      menuToggle?.focus();
    }
  });

  document.getElementById("search-toggle")?.addEventListener("click", () => {
    window.openSearch?.();
  });
</script>
