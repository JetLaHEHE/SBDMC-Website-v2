---
export interface Props {
  pages: { label: string; href?: string }[];
}
const { pages } = Astro.props;
---

<nav aria-label="Breadcrumb" class="bg-gray-50 border-b border-gray-100">
  <div class="mx-auto max-w-7xl px-4 py-3 sm:px-6 lg:px-8">
    <ol class="flex items-center gap-2 text-sm">
      <li>
        <a href="/" class="text-gray-500 transition-all hover:text-primary-500">Home</a>
      </li>
      {pages.map((page, i) => (
        <li class="flex items-center gap-2">
          <svg class="h-3.5 w-3.5 text-gray-300" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
          {page.href ? (
            <a href={page.href} class="text-gray-500 transition-all hover:text-primary-500">{page.label}</a>
          ) : (
            <span class="text-primary-500 font-medium">{page.label}</span>
          )}
        </li>
      ))}
    </ol>
  </div>
</nav>
