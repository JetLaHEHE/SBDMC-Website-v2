---
import contact from "../data/contact.json";
import { getLangPrefix, t, type LangCode } from "../i18n";
import footerTranslations from "../data/translations/footer.json";

const { lang = "en" } = Astro.props as { lang?: LangCode };
const ft = t(footerTranslations, lang);
const langPrefix = getLangPrefix(lang);
---

<footer class="bg-primary-800 text-gray-400">
  <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <div>
        <div class="mb-4 flex items-center gap-2">
          <img src="/images/logo.png" alt="SBDMC, Inc." class="h-8 w-auto" />
          <span class="text-base font-bold text-white">SBDMC, Inc.</span>
        </div>
        <p class="mb-4 text-sm leading-relaxed text-gray-400">{ft.footerDescription}</p>
      </div>

      <div>
        <h4 class="mb-5 text-xs font-semibold tracking-wider text-gray-300 uppercase">{ft.quickLinksTitle}</h4>
        <ul class="space-y-2">
          {ft.quickLinks.map((link) => (
            <li>
              <a href={langPrefix + link.href} class="text-sm transition-all hover:text-white">{link.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h4 class="mb-5 text-xs font-semibold tracking-wider text-gray-300 uppercase">{ft.servicesTitle}</h4>
        <ul class="space-y-2">
          {ft.services.map((link) => (
            <li>
              <a href={langPrefix + link.href} class="text-sm transition-all hover:text-white">{link.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h4 class="mb-5 text-xs font-semibold tracking-wider text-gray-300 uppercase">Contact</h4>
        <ul class="space-y-3 text-sm">
          <li class="flex items-start gap-3">
            <svg aria-hidden="true" class="mt-0.5 h-4 w-4 shrink-0 text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
            <span class="text-gray-400">{
              contact.address.split(",").map((part, i, arr) => (
                <>{part}{i < arr.length - 1 ? <br /> : ""}</>
              ))
            }</span>
          </li>
          <li class="flex items-center gap-3">
            <svg aria-hidden="true" class="h-4 w-4 shrink-0 text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
            <span class="text-gray-400">{contact.phone}</span>
          </li>
          <li class="flex items-center gap-3">
            <svg aria-hidden="true" class="h-4 w-4 shrink-0 text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
            <span class="text-gray-400">{contact.email}</span>
          </li>
        </ul>
      </div>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-4 px-4 py-6 sm:flex-row sm:px-6 lg:px-8">
      <p class="text-sm text-gray-500">&copy; {new Date().getFullYear()} SBDMC, Inc. {ft.copyright}</p>
      <div class="flex items-center gap-4">
        {ft.legal?.map((link) => (
          <a href={langPrefix + link.href} class="text-sm text-gray-500 transition-all hover:text-white">{link.label}</a>
        ))}
      </div>
      <a href="https://www.facebook.com/sbdmc/" target="_blank" rel="noopener noreferrer" class="flex max-md:h-10 max-md:w-10 md:h-8 md:w-8 items-center justify-center rounded-lg bg-white/5 text-gray-500 transition-all hover:bg-accent-600 hover:text-white" aria-label={ft.facebookLabel}>
        <svg aria-hidden="true" class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z" /></svg>
      </a>
    </div>
  </div>
</footer>
