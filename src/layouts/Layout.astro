---
import "../styles/global.css";
import "aos/dist/aos.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import BackToTop from "../components/BackToTop.astro";
// import CookieConsent from "../components/CookieConsent.astro";
import Search from "../components/Search.astro";
import Chatbot from "../components/Chatbot.astro";
import { getLangFromParams, getHreflangs, t, LANGUAGES, type LangCode } from "../i18n";
import layoutTranslations from "../data/translations/layout.json";

const { title, description, ogImage } = Astro.props;
const lang = (Astro.props.lang || getLangFromParams(Astro.params)) as LangCode;
const langConfig = LANGUAGES.find((l) => l.code === lang)!;
const lo = t(layoutTranslations, lang);

const siteName = lo.siteName;
const pageTitle = title ? `${title} | ${siteName}` : siteName;
const pageDesc = description || lo.defaultDescription;
const canonical = Astro.url.pathname;
const defaultOgImage = ogImage || "/images/og-default.svg";
const baseUrl = "https://sbdmc.netlify.app";
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#040A5E" />

    <link rel="canonical" href={`${baseUrl}${canonical}`} />
    <link rel="icon" type="image/png" href="/images/logo.png" />
    {getHreflangs(Astro.url.pathname, baseUrl).map(({ lang: hl, href }) => (
      <link rel="alternate" hreflang={hl} href={href} />
    ))}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:image" content={`${baseUrl}${defaultOgImage}`} />
    <meta property="og:url" content={`${baseUrl}${canonical}`} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content={langConfig.locale} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDesc} />
    <meta name="twitter:image" content={`${baseUrl}${defaultOgImage}`} />

    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag("consent", "default", {
        ad_storage: "denied",
        ad_user_data: "denied",
        ad_personalization: "denied",
        analytics_storage: "denied",
      });
    </script>
    <script is:inline>
      window.addEventListener("cookie-consent-accepted", () => {
        gtag("consent", "update", {
          ad_storage: "granted",
          ad_user_data: "granted",
          ad_personalization: "granted",
          analytics_storage: "granted",
        });
      });
    </script>

    <script async src="https://www.googletagmanager.com/gtag/js?id=G-XXXXXXXXXX" is:inline></script>
    <script is:inline>
      gtag("js", new Date());
      gtag("config", "G-XXXXXXXXXX");
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" media="print" onload="this.media='all'" />

    <script type="application/ld+json" is:inline>
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": {JSON.stringify(lo.schemaName)},
      "url": {JSON.stringify(baseUrl)},
      "logo": {JSON.stringify(`${baseUrl}/images/logo.png`)},
      "description": {JSON.stringify(lo.schemaDescription)},
      "address": {
        "@type": "PostalAddress",
        "addressLocality": {JSON.stringify(lo.addressLocality)},
        "addressCountry": "PH"
      }
    }
    </script>
  </head>
  <body>
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-[200] focus:bg-white focus:text-primary-500 focus:px-4 focus:py-3 focus:rounded-lg focus:shadow-xl focus:text-sm focus:font-semibold focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2">
      {lo.skipLink}
    </a>
    <Header currentPath={canonical} lang={lang} />
    <main id="main-content" data-pagefind-body>
      <slot />
    </main>
    <Footer lang={lang} />
    <!-- <CookieConsent lang={lang} /> -->
    <Search lang={lang} />
    <Chatbot lang={lang} />
    <BackToTop lang={lang} />
    <script src="https://identity.netlify.com/v1/netlify-identity-widget.js" is:inline></script>
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js" is:inline></script>
    <script is:inline>
      document.addEventListener("DOMContentLoaded", function () {
        AOS.init({
          duration: 600,
          once: true,
          offset: 80,
          easing: "ease-out-cubic",
        });
      });
      if (window.netlifyIdentity) {
        netlifyIdentity.on("init", function (user) {
          if (!user) {
            netlifyIdentity.on("login", function () {
              document.location.href = "/admin/";
            });
          }
        });
      }
    </script>
  </body>
</html>
